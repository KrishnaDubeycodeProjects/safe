# ─────────────────────────────────────────────────────────────────────────────
# Digital-arrest-detector — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
APP_PORT=8001
APP_LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Development: CORS_ORIGINS=*
# Production:  CORS_ORIGINS=https://yourdomain.com
CORS_ORIGINS=*

# Trusted hostnames for Host-header protection
# Production: TRUSTED_HOSTS=yourdomain.com,www.yourdomain.com
TRUSTED_HOSTS=*

# ── Gmail OAuth (for feedback emails) ────────────────────────────────────────
# Place credentials.json (OAuth client) in the project root.
# On first run, a browser will open for authorization → token.json is created.
# In production, pre-authorize locally and copy token.json to the server.

# ── Community Reporting ───────────────────────────────────────────────────────
# Path where community reports database is stored
COMMUNITY_DB_PATH=data/community_reports.json

# ── YouTube Data API v3 ────────────────────────────────────────────────────────
# Used to surface related scam-awareness videos alongside community search results.
# Create a key at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3").
# Restrict it to that API + your server IP in production. NEVER expose it to the frontend.
YOUTUBE_API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Handled by slowapi — limits are configured per-endpoint in app.py
# Additional nginx-level limits are configured in nginx/nginx.conf
