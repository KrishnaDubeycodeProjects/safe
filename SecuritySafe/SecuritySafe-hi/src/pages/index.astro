---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ScannerInput from '../components/ScannerInput.astro';
import ScannerResult from '../components/ScannerResult.astro';
---

<Layout title="SAFE - Scan & Verify" currentPage="scan">
  <main class="main-home">
    <!-- Subtle Wavy Mint Glow Background on top half -->
    <div class="hero-bg-waves" aria-hidden="true"></div>

    <div class="app-container">
      <!-- 1. Centered Hero -->
      <Hero />

      <!-- 2. Main Action Card (Run Investigation, Text, Image) -->
      <ScannerInput />

      <!-- 3. Text / Image Scanner Result Component -->
      <ScannerResult />

      <!-- 4. Stats Bar (Full-Width Card Below Action Card) -->
      <section class="stats-bar-section">
        <div class="stats-card">
          <div class="stat-col">
            <span class="stat-value">&lt;1s</span>
            <span class="stat-label">SCAN RESPONSE</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-col">
            <span class="stat-value stat-highlight">24/7</span>
            <span class="stat-label">REAL-TIME DEFENSE</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-col">
            <span class="stat-value">100%</span>
            <span class="stat-label">FREE &amp; CONFIDENTIAL</span>
          </div>
        </div>
      </section>

      <!-- 5. Action List (Bottom Section: Feedback, Fraud Learning, Emergency) -->
      <section class="action-list-section">
        <!-- Card 1: Feedback -->
        <a href="/feedback" class="action-card">
          <div class="action-icon-box icon-teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <div class="action-card-text">
            <h3 class="action-card-title">Feedback</h3>
            <p class="action-card-sub">Help us to Improve your Experience</p>
          </div>
          <div class="action-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </div>
        </a>

        <!-- Card 2: Fraud Learning Center -->
        <a href="/learn" class="action-card">
          <div class="action-icon-box icon-teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="3"/>
              <line x1="5" y1="14" x2="19" y2="14"/>
            </svg>
          </div>
          <div class="action-card-text">
            <h3 class="action-card-title">Fraud Learning Center</h3>
            <p class="action-card-sub">Learn about scams</p>
          </div>
          <div class="action-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </div>
        </a>

        <!-- Card 3: Emergency Center -->
        <a href="/emergency" class="action-card">
          <div class="action-icon-box icon-red">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <div class="action-card-text">
            <h3 class="action-card-title">Emergency Center</h3>
            <p class="action-card-sub">Fraud response</p>
          </div>
          <div class="action-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </div>
        </a>
      </section>
    </div>
  </main>

  <!-- Floating Write Blog Button -->
  <a href="/submit-blog" class="write-fab" id="writeFab" aria-label="Write a Blog">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 20h9"/>
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
    </svg>
    <span class="fab-label">Write a Blog</span>
  </a>
</Layout>

<style is:global>
  .main-home {
    position: relative;
    min-height: 100vh;
    background: #F8FCFA;
    overflow-x: hidden;
    padding-bottom: 48px;
  }

  /* Wavy soft light-green mesh background on the upper half */
  .hero-bg-waves {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 440px;
    background: 
      radial-gradient(circle at 10% 18%, rgba(190, 245, 220, 0.75) 0%, rgba(220, 252, 238, 0.4) 45%, transparent 75%),
      radial-gradient(circle at 90% 12%, rgba(205, 250, 232, 0.6) 0%, rgba(232, 252, 245, 0.3) 50%, transparent 80%),
      linear-gradient(180deg, #EDFCF6 0%, #F5FDF9 65%, rgba(248, 252, 250, 0) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .app-container {
    max-width: 480px;
    margin: 0 auto;
    padding: 0 16px;
    position: relative;
    z-index: 1;
  }

  /* Stats Bar Section */
  .stats-bar-section {
    margin-top: 4px;
    margin-bottom: 14px;
  }
  .stats-card {
    background: #EDF8F4;
    border: 1px solid #D2EDE2;
    border-radius: 16px;
    padding: 13px 8px;
    display: grid;
    grid-template-columns: 1fr 1px 1.2fr 1px 1fr;
    align-items: center;
    text-align: center;
  }
  .stat-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .stat-value {
    font-size: 18px;
    font-weight: 800;
    color: #064E3B;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .stat-value.stat-highlight {
    color: #059669;
  }
  .stat-label {
    font-size: 9px;
    font-weight: 700;
    color: #64748B;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }
  .stat-divider {
    width: 1px;
    height: 28px;
    background: #D1EAE0;
    margin: 0 auto;
  }

  /* Action List Section */
  .action-list-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 4px;
  }
  .action-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #FFFFFF;
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: 16px;
    padding: 15px 16px;
    text-decoration: none;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .action-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.06);
    border-color: #CBD5E1;
  }
  .action-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .action-icon-box.icon-teal {
    background: #D2F6EA;
  }
  .action-icon-box.icon-red {
    background: #FEE2E2;
  }
  .action-card-text {
    flex: 1;
    min-width: 0;
  }
  .action-card-title {
    font-size: 15.5px;
    font-weight: 700;
    color: #0F172A;
    margin: 0;
    line-height: 1.25;
  }
  .action-card-sub {
    font-size: 12.5px;
    color: #64748B;
    margin: 2px 0 0;
    line-height: 1.3;
  }
  .action-card-arrow {
    color: #64748B;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .action-card:hover .action-card-arrow {
    transform: translateX(3px);
    color: #0F172A;
  }

  /* Floating Write Blog FAB */
  .write-fab {
    position: fixed;
    bottom: 104px;
    right: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #062319;
    color: #fff;
    border-radius: 100px;
    padding: 12px 16px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 4px 16px rgba(0,0,0,0.18);
    z-index: 90;
    transition: all 0.25s cubic-bezier(0.16,1,0.3,1);
    overflow: hidden;
    max-width: 52px;
    white-space: nowrap;
  }
  .write-fab:hover {
    max-width: 160px;
    background: #0A3728;
    box-shadow: 0 8px 24px rgba(0,0,0,0.22);
    transform: translateY(-2px);
  }
  .fab-label {
    opacity: 0;
    width: 0;
    overflow: hidden;
    transition: opacity 0.2s 0.05s, width 0.25s;
  }
  .write-fab:hover .fab-label {
    opacity: 1;
    width: auto;
  }

  @media (max-width: 767px) {
    .write-fab {
      bottom: 88px;
      right: 16px;
      padding: 11px 14px;
    }
  }
</style>