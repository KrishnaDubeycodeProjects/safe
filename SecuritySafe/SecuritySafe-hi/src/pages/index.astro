---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ScannerInput from '../components/ScannerInput.astro';
import ScannerResult from '../components/ScannerResult.astro';
---

<Layout title="SAFE - Scan & Verify" currentPage="scan">
  <main class="main-home">
    <!-- Subtle Wavy Mint Glow Background on top half -->
    <div class="hero-bg-waves" aria-hidden="true"></div>

    <div class="app-container">
      <!-- 1. Centered Hero -->
      <Hero />

      <!-- 2. Main Action Card (Run Investigation, Text, Image) -->
      <ScannerInput />

      <!-- 3. Text / Image Scanner Result Component -->
      <ScannerResult />

      <!-- 4. Stats Bar (Full-Width Card Below Action Card) -->
      <section class="stats-bar-section">
        <div class="stats-card">
          <div class="stat-col">
            <span class="stat-value">&lt;1s</span>
            <span class="stat-label">SCAN RESPONSE</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-col">
            <span class="stat-value stat-highlight">24/7</span>
            <span class="stat-label">REAL-TIME DEFENSE</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-col">
            <span class="stat-value">100%</span>
            <span class="stat-label">FREE &amp; CONFIDENTIAL</span>
          </div>
        </div>
      </section>

      <!-- 5. Action List (Bottom Section: Blogs, Feedback, Fraud Learning, Emergency) -->
      <section class="action-list-section">
        <!-- Card 1: Scam Stories & Blogs -->
        <a href="/blogs" class="action-card">
          <div class="action-icon-box icon-teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
          </div>
          <div class="action-card-text">
            <h3 class="action-card-title">Scam Stories &amp; Blogs</h3>
            <p class="action-card-sub">Real victim stories &amp; breakdowns</p>
          </div>
          <div class="action-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </div>
        </a>

        <!-- Card 2: Feedback -->
        <a href="/feedback" class="action-card">
          <div class="action-icon-box icon-teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <div class="action-card-text">
            <h3 class="action-card-title">Feedback</h3>
            <p class="action-card-sub">Help us to Improve your Experience</p>
          </div>
          <div class="action-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </div>
        </a>

        <!-- Card 3: Fraud Learning Center -->
        <a href="/learn" class="action-card">
          <div class="action-icon-box icon-teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="3"/>
              <line x1="5" y1="14" x2="19" y2="14"/>
            </svg>
          </div>
          <div class="action-card-text">
            <h3 class="action-card-title">Fraud Learning Center</h3>
            <p class="action-card-sub">Learn about scams</p>
          </div>
          <div class="action-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </div>
        </a>

        <!-- Card 4: Emergency Center -->
        <a href="/emergency" class="action-card">
          <div class="action-icon-box icon-red">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <div class="action-card-text">
            <h3 class="action-card-title">Emergency Center</h3>
            <p class="action-card-sub">Fraud response</p>
          </div>
          <div class="action-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </div>
        </a>
      </section>
    </div>

    <!-- 6. Recommended Blogs Section (Latest safety stories & breakdowns) -->
    <section class="home-blogs-section">
      <div class="app-container">
        <div class="home-blogs-header">
          <div>
            <span class="home-blogs-badge">LATEST SAFETY ALERTS &amp; STORIES</span>
            <h2 class="home-blogs-title">Recommended Blogs &amp; Scam Breakdowns</h2>
            <p class="home-blogs-desc">Read real victim experiences, breakdown of new scam patterns, and stay protected.</p>
          </div>
          <a href="/blogs" class="view-all-blogs-btn">
            <span>View All Blogs</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
          </a>
        </div>
        <div class="home-blogs-grid" id="homeBlogsGrid">
          <!-- Skeleton Loaders -->
          <div class="home-blog-skel"></div>
          <div class="home-blog-skel"></div>
          <div class="home-blog-skel"></div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Load top 3 recommended blogs for the homepage
  document.addEventListener('DOMContentLoaded', async () => {
    const blogsGrid = document.getElementById('homeBlogsGrid');
    if (!blogsGrid) return;
    try {
      const res = await fetch('https://ixil3ly75uaxbvmqzs6mdlfj4m0kdtud.lambda-url.us-east-1.on.aws/api/blogs', { signal: AbortSignal.timeout(6000) });
      if (!res.ok) return;
      const data = await res.json();
      const blogs = (data.blogs || []).slice(0, 3);
      if (blogs.length === 0) {
        blogsGrid.style.display = 'none';
        return;
      }
      blogsGrid.innerHTML = blogs.map(b => {
        const thumb = b.images?.[0]?.url || 'https://images.unsplash.com/photo-1563986768609-322da13575f3?w=600&auto=format&fit=crop&q=80';
        const excerpt = (b.content || '').slice(0, 110) + '...';
        const tag = (b.tags || ['SCAM ALERT'])[0];
        return `
          <a href="/blogs/${encodeURIComponent(b.id)}" class="home-blog-card">
            <div class="home-blog-thumb">
              <img src="${thumb}" alt="${b.title || 'Blog'}" loading="lazy" />
            </div>
            <div class="home-blog-body">
              <div class="home-blog-tags"><span class="home-blog-tag">${tag}</span></div>
              <h3 class="home-blog-card-title">${b.title || 'Safety Alert'}</h3>
              <p class="home-blog-excerpt">${excerpt}</p>
              <span class="home-blog-read">Read Full Story →</span>
            </div>
          </a>
        `;
      }).join('');
    } catch {
      // fallback silently
    }
  });
</script>

<style is:global>
  .main-home {
    position: relative;
    min-height: 100vh;
    background: #F8FCFA;
    overflow-x: hidden;
    padding-bottom: 48px;
  }

  /* Wavy soft light-green mesh background on the upper half */
  .hero-bg-waves {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 440px;
    background: 
      radial-gradient(circle at 10% 18%, rgba(190, 245, 220, 0.75) 0%, rgba(220, 252, 238, 0.4) 45%, transparent 75%),
      radial-gradient(circle at 90% 12%, rgba(205, 250, 232, 0.6) 0%, rgba(232, 252, 245, 0.3) 50%, transparent 80%),
      linear-gradient(180deg, #EDFCF6 0%, #F5FDF9 65%, rgba(248, 252, 250, 0) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .app-container {
    max-width: 480px;
    margin: 0 auto;
    padding: 0 16px;
    position: relative;
    z-index: 1;
  }

  /* Stats Bar Section */
  .stats-bar-section {
    margin-top: 4px;
    margin-bottom: 14px;
  }
  .stats-card {
    background: #EDF8F4;
    border: 1px solid #D2EDE2;
    border-radius: 16px;
    padding: 13px 8px;
    display: grid;
    grid-template-columns: 1fr 1px 1.2fr 1px 1fr;
    align-items: center;
    text-align: center;
  }
  .stat-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .stat-value {
    font-size: 18px;
    font-weight: 800;
    color: #064E3B;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .stat-value.stat-highlight {
    color: #059669;
  }
  .stat-label {
    font-size: 9px;
    font-weight: 700;
    color: #64748B;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }
  .stat-divider {
    width: 1px;
    height: 28px;
    background: #D1EAE0;
    margin: 0 auto;
  }

  /* Action List Section */
  .action-list-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 4px;
  }
  .action-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #FFFFFF;
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: 16px;
    padding: 15px 16px;
    text-decoration: none;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .action-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.06);
    border-color: #CBD5E1;
  }
  .action-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .action-icon-box.icon-teal {
    background: #D2F6EA;
  }
  .action-icon-box.icon-red {
    background: #FEE2E2;
  }
  .action-card-text {
    flex: 1;
    min-width: 0;
  }
  .action-card-title {
    font-size: 15.5px;
    font-weight: 700;
    color: #0F172A;
    margin: 0;
    line-height: 1.25;
  }
  .action-card-sub {
    font-size: 12.5px;
    color: #64748B;
    margin: 2px 0 0;
    line-height: 1.3;
  }
  .action-card-arrow {
    color: #64748B;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .action-card:hover .action-card-arrow {
    transform: translateX(3px);
    color: #0F172A;
  }

  /* Home Recommended Blogs Section */
  .home-blogs-section {
    padding: 56px 20px 72px;
    background: #FFFFFF;
    border-top: 1px solid rgba(226, 232, 240, 0.85);
    margin-top: 40px;
  }
  .home-blogs-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .home-blogs-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #065F46;
    background: #D2F6EA;
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 8px;
  }
  .home-blogs-title {
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 6px;
    letter-spacing: -0.02em;
  }
  .home-blogs-desc {
    font-size: 13.5px;
    color: #64748B;
    margin: 0;
  }
  .view-all-blogs-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #065F46;
    background: #E8F7F0;
    border: 1px solid #A7F3D0;
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .view-all-blogs-btn:hover {
    background: #065F46;
    color: #FFFFFF;
    border-color: #065F46;
    transform: translateY(-1px);
  }
  .home-blogs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
    box-sizing: border-box;
  }
  .home-blog-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    box-sizing: border-box;
  }
  .home-blog-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0,0,0,0.06);
    border-color: #CBD5E1;
  }
  .home-blog-thumb {
    height: 160px;
    overflow: hidden;
    background: #0F172A;
  }
  .home-blog-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .home-blog-card:hover .home-blog-thumb img {
    transform: scale(1.04);
  }
  .home-blog-body {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 8px;
    box-sizing: border-box;
  }
  .home-blog-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .home-blog-tag {
    font-size: 10px;
    font-weight: 700;
    color: #065F46;
    padding: 2px 7px;
    background: #ECFDF5;
    border: 1px solid #A7F3D0;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  .home-blog-card-title {
    font-size: 15px;
    font-weight: 700;
    color: #0F172A;
    margin: 0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .home-blog-excerpt {
    font-size: 12.5px;
    color: #64748B;
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .home-blog-read {
    font-size: 12px;
    font-weight: 700;
    color: #059669;
    margin-top: 4px;
  }
  .home-blog-skel {
    height: 280px;
    background: #F1F5F9;
    border-radius: 14px;
    animation: pulseSkel 1.5s infinite;
  }
  @keyframes pulseSkel { 0%, 100% { opacity: 0.6; } 50% { opacity: 0.3; } }

  @media (max-width: 900px) {
    .home-blogs-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
  @media (max-width: 600px) {
    .home-blogs-grid { grid-template-columns: 1fr; gap: 14px; }
    .home-blogs-section { padding: 36px 14px 48px; margin-top: 28px; }
  }
</style>