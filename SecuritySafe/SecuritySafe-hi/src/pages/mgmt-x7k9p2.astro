---
// Admin panel — obfuscated URL, not linked from anywhere in the site nav.
// Gated by the ADMIN_BLOG_KEY the backend was started with (X-Admin-Key
// header). Posts are admin-authored and publish immediately — there is no
// review queue. See security-safe-chat-backend/main.py for the endpoints
// this page calls.
import Layout from '../layouts/Layout.astro';

const MAIN_API = import.meta.env.PUBLIC_MAIN_API_URL || (import.meta.env.DEV ? 'http://localhost:8000' : '');
---
<!-- Keep this page out of search engines -->
<meta name="robots" content="noindex, nofollow" />

<Layout title="Admin — SAFE Platform" currentPage="">
  <main class="admin-main">

    <!-- Key gate -->
    <div class="gate-overlay" id="gateOverlay">
      <div class="gate-card">
        <div class="gate-logo">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4" stroke-width="2"/></svg>
          <span>SAFE Admin</span>
        </div>
        <h1>Restricted Access</h1>
        <p>Enter the admin key to manage blog posts.</p>
        <form id="gateForm">
          <div class="gate-field">
            <input type="password" id="gateKey" placeholder="Enter admin key" autocomplete="off" required />
            <button type="submit" aria-label="Unlock">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
          <div class="gate-error" id="gateError" style="display:none;">Incorrect key. Try again.</div>
        </form>
        <p class="gate-hint">3 wrong attempts will lock this session.</p>
      </div>
    </div>

    <!-- Dashboard -->
    <div class="admin-dashboard" id="adminDashboard" style="display:none;">
      <header class="admin-header">
        <div class="admin-header-inner">
          <div class="admin-brand">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>SAFE Blog Admin</span>
          </div>
          <div class="admin-meta">
            <button class="new-btn" id="newBtn">+ New Post</button>
            <button class="logout-btn" id="logoutBtn">Sign out</button>
          </div>
        </div>
      </header>

      <div class="admin-body">
        <div class="stats-bar">
          <div class="stat-box">
            <span class="stat-num" id="statTotal">—</span>
            <span class="stat-label">Published Posts</span>
          </div>
        </div>

        <div class="blog-list" id="blogList">
          <div class="loading-pulse"></div>
          <div class="loading-pulse"></div>
        </div>
        <div class="empty-msg" id="listEmpty" style="display:none;">
          <p>No posts yet. Click "New Post" to publish the first one.</p>
        </div>
      </div>
    </div>

    <!-- Create / Edit drawer -->
    <div class="drawer-overlay" id="drawerOverlay">
      <div class="drawer" id="editDrawer">
        <div class="drawer-header">
          <h3 id="drawerTitle">New Post</h3>
          <button class="drawer-close" id="drawerClose" aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <form id="editForm" class="drawer-body">
          <label class="field">
            <span>Title</span>
            <input type="text" id="fTitle" required />
          </label>
          <label class="field">
            <span>Tags <em>(comma-separated)</em></span>
            <input type="text" id="fTags" placeholder="UPI Fraud, Banking & Payment Fraud" />
          </label>
          <label class="field">
            <span>Body <em>(blank line = new paragraph — reference an image with [1], [2]...)</em></span>
            <textarea id="fContent" rows="10" required></textarea>
          </label>
          <div class="field">
            <span>Images <em>(optional — order matches [1], [2]... in the body)</em></span>
            <div id="imageRows"></div>
            <button type="button" class="add-image-btn" id="addImageBtn">+ Add image</button>
          </div>
          <div class="form-error" id="formError" style="display:none;"></div>
          <div class="drawer-actions">
            <button type="button" class="btn-secondary" id="cancelBtn">Cancel</button>
            <button type="submit" class="btn-primary" id="saveBtn">Publish</button>
          </div>
        </form>
      </div>
    </div>

  </main>
</Layout>

<script define:vars={{ MAIN_API }}>
  const gateOverlay = document.getElementById('gateOverlay');
  const gateForm = document.getElementById('gateForm');
  const gateKeyInput = document.getElementById('gateKey');
  const gateError = document.getElementById('gateError');
  const adminDashboard = document.getElementById('adminDashboard');

  const blogList = document.getElementById('blogList');
  const listEmpty = document.getElementById('listEmpty');
  const statTotal = document.getElementById('statTotal');

  const drawerOverlay = document.getElementById('drawerOverlay');
  const editForm = document.getElementById('editForm');
  const drawerTitle = document.getElementById('drawerTitle');
  const fTitle = document.getElementById('fTitle');
  const fTags = document.getElementById('fTags');
  const fContent = document.getElementById('fContent');
  const imageRows = document.getElementById('imageRows');
  const formError = document.getElementById('formError');
  const saveBtn = document.getElementById('saveBtn');

  let adminKey = '';
  let attempts = 0;
  let allBlogs = [];
  let editingId = null; // null = creating a new post

  function escHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function formatDate(iso) {
    if (!iso) return '';
    return new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  // ── Key gate ────────────────────────────────────────────────────────────
  // Verifies the key with zero side effects: DELETE checks the admin key
  // before it checks whether the id exists, so deleting a bogus id returns
  // 404 for a correct key and 403 for a wrong one.
  async function verifyKey(key) {
    const res = await fetch(`${MAIN_API}/api/blogs/__verify_key__`, {
      method: 'DELETE',
      headers: { 'X-Admin-Key': key },
    });
    return res.status !== 403;
  }

  gateForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const entered = gateKeyInput.value;
    const submitBtn = gateForm.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    try {
      const ok = await verifyKey(entered);
      if (ok) {
        adminKey = entered;
        sessionStorage.setItem('safe_admin_key', entered);
        gateOverlay.style.display = 'none';
        adminDashboard.style.display = 'block';
        loadBlogs();
      } else {
        attempts++;
        gateError.style.display = 'block';
        gateKeyInput.value = '';
        if (attempts >= 3) {
          gateForm.querySelector('button, input').disabled = true;
          gateKeyInput.disabled = true;
          submitBtn.disabled = true;
          gateError.textContent = 'Too many attempts. Reload the page to try again.';
        }
      }
    } catch {
      gateError.textContent = 'Could not reach the server. Try again.';
      gateError.style.display = 'block';
    } finally {
      if (attempts < 3) submitBtn.disabled = false;
    }
  });

  document.getElementById('logoutBtn').addEventListener('click', () => {
    sessionStorage.removeItem('safe_admin_key');
    location.reload();
  });

  // ── List ────────────────────────────────────────────────────────────────
  async function loadBlogs() {
    blogList.innerHTML = `<div class="loading-pulse"></div><div class="loading-pulse"></div>`;
    listEmpty.style.display = 'none';
    try {
      const res = await fetch(`${MAIN_API}/api/blogs`);
      if (!res.ok) throw new Error(`Server error ${res.status}`);
      const data = await res.json();
      allBlogs = (data.blogs || []).slice().sort((a, b) => (b.created_at || '').localeCompare(a.created_at || ''));
      statTotal.textContent = String(allBlogs.length);
      renderList();
    } catch (e) {
      blogList.innerHTML = `<div class="fetch-error">Could not load posts — ${escHtml(e.message)}</div>`;
    }
  }

  function renderList() {
    if (!allBlogs.length) {
      blogList.innerHTML = '';
      listEmpty.style.display = 'block';
      return;
    }
    listEmpty.style.display = 'none';
    blogList.innerHTML = allBlogs.map(b => `
      <div class="blog-row" data-id="${escHtml(b.id)}">
        <div class="row-main">
          <span class="row-title">${escHtml(b.title)}</span>
          <span class="row-meta">${(b.tags || []).map(escHtml).join(', ')} · ${formatDate(b.created_at)}</span>
        </div>
        <div class="row-actions">
          <button class="row-btn edit-btn" data-id="${escHtml(b.id)}">Edit</button>
          <button class="row-btn delete-btn" data-id="${escHtml(b.id)}">Delete</button>
        </div>
      </div>
    `).join('');

    blogList.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => openEditor(btn.dataset.id));
    });
    blogList.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', () => deletePost(btn.dataset.id));
    });
  }

  async function deletePost(id) {
    const blog = allBlogs.find(b => b.id === id);
    if (!confirm(`Delete "${blog ? blog.title : 'this post'}"? This can't be undone.`)) return;
    try {
      const res = await fetch(`${MAIN_API}/api/blogs/${encodeURIComponent(id)}`, {
        method: 'DELETE',
        headers: { 'X-Admin-Key': adminKey },
      });
      if (!res.ok) throw new Error(`Server error ${res.status}`);
      await loadBlogs();
    } catch (e) {
      alert(`Could not delete post: ${e.message}`);
    }
  }

  // ── Image rows ──────────────────────────────────────────────────────────
  function addImageRow(url = '', title = '') {
    const row = document.createElement('div');
    row.className = 'image-row';
    row.innerHTML = `
      <input type="text" class="img-url" placeholder="Image URL" value="${escHtml(url)}" />
      <input type="text" class="img-caption" placeholder="Caption (optional)" value="${escHtml(title)}" />
      <button type="button" class="remove-image-btn" aria-label="Remove">&times;</button>
    `;
    row.querySelector('.remove-image-btn').addEventListener('click', () => row.remove());
    imageRows.appendChild(row);
  }
  document.getElementById('addImageBtn').addEventListener('click', () => addImageRow());

  function collectImages() {
    return [...imageRows.querySelectorAll('.image-row')]
      .map(row => ({
        url: row.querySelector('.img-url').value.trim(),
        title: row.querySelector('.img-caption').value.trim(),
      }))
      .filter(img => img.url);
  }

  // ── Editor drawer ───────────────────────────────────────────────────────
  function openEditor(id) {
    editingId = id || null;
    formError.style.display = 'none';
    imageRows.innerHTML = '';

    if (id) {
      const blog = allBlogs.find(b => b.id === id);
      drawerTitle.textContent = 'Edit Post';
      saveBtn.textContent = 'Save Changes';
      fTitle.value = blog.title || '';
      fTags.value = (blog.tags || []).join(', ');
      fContent.value = blog.content_text || '';
      (blog.images || []).forEach(img => addImageRow(img.url, img.title));
    } else {
      drawerTitle.textContent = 'New Post';
      saveBtn.textContent = 'Publish';
      editForm.reset();
    }
    drawerOverlay.classList.add('active');
  }

  function closeEditor() {
    drawerOverlay.classList.remove('active');
    editingId = null;
  }

  document.getElementById('newBtn').addEventListener('click', () => openEditor(null));
  document.getElementById('drawerClose').addEventListener('click', closeEditor);
  document.getElementById('cancelBtn').addEventListener('click', closeEditor);
  drawerOverlay.addEventListener('click', (e) => { if (e.target === drawerOverlay) closeEditor(); });

  editForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.style.display = 'none';
    saveBtn.disabled = true;

    const body = {
      title: fTitle.value.trim(),
      tags: fTags.value.split(',').map(t => t.trim()).filter(Boolean),
      content_text: fContent.value,
      images: collectImages(),
    };

    try {
      const url = editingId ? `${MAIN_API}/api/blogs/${encodeURIComponent(editingId)}` : `${MAIN_API}/api/blogs`;
      const method = editingId ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json', 'X-Admin-Key': adminKey },
        body: JSON.stringify(body),
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.detail || `Server error ${res.status}`);
      }
      closeEditor();
      await loadBlogs();
    } catch (e2) {
      formError.textContent = e2.message;
      formError.style.display = 'block';
    } finally {
      saveBtn.disabled = false;
    }
  });

  // Resume session if the key was already verified this tab
  const savedKey = sessionStorage.getItem('safe_admin_key');
  if (savedKey) {
    verifyKey(savedKey).then(ok => {
      if (ok) {
        adminKey = savedKey;
        gateOverlay.style.display = 'none';
        adminDashboard.style.display = 'block';
        loadBlogs();
      } else {
        sessionStorage.removeItem('safe_admin_key');
      }
    });
  }
</script>

<style>
.admin-main { min-height: 100vh; background: var(--canvas-soft, #fafafa); }

/* Gate */
.gate-overlay {
  position: fixed; inset: 0; z-index: 2000;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 60%, #16213e 100%);
  padding: 24px;
}
.gate-card {
  background: #fff; border-radius: 20px; padding: 40px; max-width: 380px; width: 100%;
  text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}
.gate-logo { display: flex; align-items: center; justify-content: center; gap: 8px; color: var(--ink,#171717); font-weight: 700; margin-bottom: 20px; }
.gate-card h1 { font-size: 1.3rem; margin: 0 0 8px; color: var(--ink,#171717); }
.gate-card p { color: var(--mute,#888); font-size: 0.9rem; margin: 0 0 24px; }
.gate-field { display: flex; gap: 8px; }
.gate-field input {
  flex: 1; padding: 12px 14px; border: 1px solid var(--hairline,#ebebeb); border-radius: 10px; font-size: 14px;
}
.gate-field button {
  width: 44px; border: none; border-radius: 10px; background: var(--ink,#171717); color: #fff; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}
.gate-field button:disabled { opacity: 0.5; cursor: not-allowed; }
.gate-error { color: #ee0000; font-size: 13px; margin-top: 12px; }
.gate-hint { font-size: 12px; color: var(--mute,#aaa); margin-top: 20px !important; }

/* Dashboard */
.admin-header { background: #fff; border-bottom: 1px solid var(--hairline,#ebebeb); position: sticky; top: 0; z-index: 10; }
.admin-header-inner { max-width: 900px; margin: 0 auto; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; }
.admin-brand { display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--ink,#171717); }
.admin-meta { display: flex; gap: 10px; }
.new-btn {
  padding: 8px 16px; background: var(--ink,#171717); color: #fff; border: none; border-radius: 100px;
  font-size: 13px; font-weight: 700; cursor: pointer;
}
.logout-btn {
  padding: 8px 16px; background: none; border: 1px solid var(--hairline,#ebebeb); border-radius: 100px;
  font-size: 13px; cursor: pointer; color: var(--body,#525252);
}
.admin-body { max-width: 900px; margin: 0 auto; padding: 32px 24px 80px; }

.stats-bar { margin-bottom: 24px; }
.stat-box { display: inline-flex; flex-direction: column; gap: 2px; }
.stat-num { font-size: 2rem; font-weight: 800; color: var(--ink,#171717); }
.stat-label { font-size: 12px; color: var(--mute,#888); text-transform: uppercase; letter-spacing: 0.05em; }

.blog-list { display: flex; flex-direction: column; gap: 10px; }
.blog-row {
  background: #fff; border: 1px solid var(--hairline,#ebebeb); border-radius: 12px;
  padding: 16px 18px; display: flex; align-items: center; justify-content: space-between; gap: 12px;
}
.row-main { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.row-title { font-weight: 700; color: var(--ink,#171717); font-size: 0.95rem; }
.row-meta { font-size: 12px; color: var(--mute,#888); }
.row-actions { display: flex; gap: 8px; flex-shrink: 0; }
.row-btn {
  padding: 6px 14px; border-radius: 100px; font-size: 12px; font-weight: 600; cursor: pointer;
  border: 1px solid var(--hairline,#ebebeb); background: none; color: var(--body,#525252);
}
.row-btn:hover { border-color: var(--ink,#171717); color: var(--ink,#171717); }
.delete-btn:hover { border-color: #ee0000; color: #ee0000; }

.loading-pulse {
  height: 66px; border-radius: 12px; border: 1px solid var(--hairline,#ebebeb);
  background: linear-gradient(90deg, #fafafa 25%, #f2f2f2 50%, #fafafa 75%);
  background-size: 200% 100%; animation: shimmer 1.4s infinite;
}
@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
.empty-msg, .fetch-error { text-align: center; padding: 40px; color: var(--mute,#888); font-size: 0.9rem; }
.fetch-error { color: #ee0000; }

/* Drawer */
.drawer-overlay {
  position: fixed; inset: 0; z-index: 1500; background: rgba(10,10,10,0.5);
  display: flex; justify-content: flex-end; opacity: 0; visibility: hidden; transition: all 0.25s ease;
}
.drawer-overlay.active { opacity: 1; visibility: visible; }
.drawer {
  background: #fff; width: 100%; max-width: 520px; height: 100%; overflow-y: auto;
  transform: translateX(20px); transition: transform 0.25s ease;
}
.drawer-overlay.active .drawer { transform: translateX(0); }
.drawer-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 24px; border-bottom: 1px solid var(--hairline,#ebebeb);
}
.drawer-header h3 { margin: 0; font-size: 1.05rem; color: var(--ink,#171717); }
.drawer-close { background: none; border: none; cursor: pointer; color: var(--mute,#888); }
.drawer-body { padding: 24px; display: flex; flex-direction: column; gap: 18px; }

.field { display: flex; flex-direction: column; gap: 6px; }
.field > span { font-size: 13px; font-weight: 600; color: var(--ink,#171717); }
.field em { font-weight: 400; color: var(--mute,#888); font-style: normal; font-size: 12px; }
.field input[type="text"], .field textarea {
  padding: 10px 12px; border: 1px solid var(--hairline,#ebebeb); border-radius: 8px; font-size: 14px; font-family: inherit;
}
.field textarea { resize: vertical; line-height: 1.5; }

.image-row { display: flex; gap: 8px; margin-bottom: 8px; align-items: center; }
.image-row input {
  flex: 1; padding: 8px 10px; border: 1px solid var(--hairline,#ebebeb); border-radius: 8px; font-size: 13px;
}
.remove-image-btn {
  width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--hairline,#ebebeb); background: none;
  cursor: pointer; color: var(--mute,#888); flex-shrink: 0;
}
.add-image-btn {
  margin-top: 4px; background: none; border: 1px dashed var(--hairline,#ccc); border-radius: 8px;
  padding: 8px; font-size: 12px; color: var(--body,#525252); cursor: pointer; width: 100%;
}

.form-error { color: #ee0000; font-size: 13px; }

.drawer-actions { display: flex; gap: 10px; justify-content: flex-end; padding-top: 8px; border-top: 1px solid var(--hairline,#ebebeb); }
.btn-secondary, .btn-primary {
  padding: 10px 20px; border-radius: 100px; font-size: 13px; font-weight: 700; cursor: pointer; border: none;
}
.btn-secondary { background: none; border: 1px solid var(--hairline,#ebebeb); color: var(--body,#525252); }
.btn-primary { background: var(--ink,#171717); color: #fff; }
.btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }
</style>
