---
// src/components/ScannerResult.astro
// Renders the clean forensic result card matching the Safe UI design
---

<section class="result-section hidden" id="scan-result">
  <div class="result-container">

    <!-- Main Result Card -->
    <div class="result-card">

      <!-- Full-Width Banner Header -->
      <div class="result-banner" id="result-banner">
        <div class="banner-icon-circle" id="banner-icon-circle">
          <svg id="banner-icon-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
        </div>
        <h1 class="banner-title" id="banner-verdict-title">Invalid request</h1>
      </div>

      <!-- Card Content Body -->
      <div class="result-body">

        <!-- Why / Explanation Section -->
        <div class="content-block">
          <h2 class="block-heading" id="why-heading">Why it's invalid</h2>
          <p class="block-text" id="why-body">
            This is not a question about whether something is a scam. I am a scam detection assistant and can only help with scam-related inquiries.
          </p>
        </div>

        <div class="content-divider"></div>

        <!-- Visual Evidence Section (Images only) -->
        <div class="content-block hidden" id="visual-evidence-block">
          <h2 class="block-heading">Visual evidence</h2>
          <ul class="clean-bullet-list" id="visual-evidence-list">
          </ul>
          <div class="content-divider"></div>
        </div>

        <!-- Extracted Text Section (Images with detected text only) -->
        <div class="content-block hidden" id="ocr-text-block">
          <h2 class="block-heading">Extracted text from image</h2>
          <div class="ocr-text-box" id="ocr-text-display"></div>
          <div class="content-divider"></div>
        </div>

        <!-- Next Steps Section -->
        <div class="content-block" id="next-steps-block">
          <h2 class="block-heading">Next steps</h2>
          <div class="steps-container" id="steps-container">
            <div class="step-row">
              <div class="step-circle">1</div>
              <p class="step-instruction">
                Please ask me a question about a message, email, call, or situation you suspect might be a scam.
              </p>
            </div>
          </div>
        </div>

        <!-- Footer Action Button: Start Scanning (No Share Result button) -->
        <div class="result-footer-actions">
          <button type="button" class="start-scanning-btn" id="start-scanning-button" onclick="startScanningAgain()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Start Scanning</span>
          </button>
        </div>

      </div>

    </div>

    <!-- Safety Disclaimer -->
    <p class="safe-disclaimer">
      🔒 This assessment is AI guidance based on the submitted input alone. When in doubt, verify independently through official channels.
    </p>

  </div>
</section>

<script>
  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  window.renderDetailedResult = function(data, isImage = false) {
    const section = document.getElementById('scan-result');
    if (!section) return;

    data = data || {};
    const verdict = data.verdict || data.tag || 'Invalid request';
    const vLower = verdict.toLowerCase();

    // Configure theme matching the uploaded reference image:
    // Purple/lavender for invalid, red-tint for definitely a scam, amber for likely a scam, green for legitimate
    const banner = document.getElementById('result-banner');
    const iconCircle = document.getElementById('banner-icon-circle');
    const iconSvg = document.getElementById('banner-icon-svg');
    const titleEl = document.getElementById('banner-verdict-title');

    if (titleEl) titleEl.textContent = verdict;

    if (vLower.includes('invalid')) {
      if (banner) banner.style.background = '#E2DEE9';
      if (iconCircle) {
        iconCircle.style.background = '#9994A5';
        iconCircle.style.color = '#FFFFFF';
      }
      if (iconSvg) {
        iconSvg.innerHTML = `<line x1="6" y1="12" x2="18" y2="12"/>`;
      }
    } else if (vLower.includes('definitely') || vLower.includes('scam image') || (data.combined_prob >= 0.6)) {
      if (banner) banner.style.background = '#FCE8E6';
      if (iconCircle) {
        iconCircle.style.background = '#EA4335';
        iconCircle.style.color = '#FFFFFF';
      }
      if (iconSvg) {
        iconSvg.innerHTML = `<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>`;
      }
    } else if (vLower.includes('likely a scam') || vLower.includes('likely ai') || vLower.includes('indeterminate') || (data.combined_prob >= 0.3)) {
      if (banner) banner.style.background = '#FEF3C7';
      if (iconCircle) {
        iconCircle.style.background = '#D97706';
        iconCircle.style.color = '#FFFFFF';
      }
      if (iconSvg) {
        iconSvg.innerHTML = `<line x1="12" y1="9" x2="12" y2="13"/><circle cx="12" cy="17" r="1" fill="currentColor"/>`;
      }
    } else {
      // Legitimate / Authentic
      if (banner) banner.style.background = '#E6F4EA';
      if (iconCircle) {
        iconCircle.style.background = '#34A853';
        iconCircle.style.color = '#FFFFFF';
      }
      if (iconSvg) {
        iconSvg.innerHTML = `<polyline points="20 6 9 17 4 12"/>`;
      }
    }

    // Set Why Heading & Body
    const whyHeading = document.getElementById('why-heading');
    const whyBody = document.getElementById('why-body');

    let dynamicWhyTitle = data.why_title;
    if (!dynamicWhyTitle) {
      if (vLower.includes('invalid')) {
        dynamicWhyTitle = "Why it's invalid";
      } else if (vLower.includes('scam')) {
        dynamicWhyTitle = isImage ? "Why this matters" : "Why it's a scam";
      } else if (vLower.includes('legitimate') || vLower.includes('authentic')) {
        dynamicWhyTitle = "Why it's likely legitimate";
      } else {
        dynamicWhyTitle = isImage ? "Why this matters" : "Why";
      }
    }

    if (whyHeading) whyHeading.textContent = dynamicWhyTitle;
    const whyText = data.why || data.why_it_matters || data.message || data.explanation || 'This request could not be analyzed.';
    if (whyBody) whyBody.textContent = whyText;

    // Visual Evidence Block (Images)
    const visBlock = document.getElementById('visual-evidence-block');
    const visList = document.getElementById('visual-evidence-list');
    const evidence = data.visual_evidence || [];
    if (isImage && evidence.length > 0 && visList) {
      visBlock?.classList.remove('hidden');
      visList.innerHTML = '';
      evidence.forEach(item => {
        visList.innerHTML += `<li class="bullet-item">${escapeHtml(item)}</li>`;
      });
    } else {
      visBlock?.classList.add('hidden');
    }

    // OCR Text Block (Images)
    const ocrBlock = document.getElementById('ocr-text-block');
    const ocrDisplay = document.getElementById('ocr-text-display');
    if (isImage && data.ocr_text && data.ocr_text.trim() && ocrDisplay) {
      ocrBlock?.classList.remove('hidden');
      ocrDisplay.textContent = data.ocr_text.trim();
    } else {
      ocrBlock?.classList.add('hidden');
    }

    // Next Steps Block
    const stepsBlock = document.getElementById('next-steps-block');
    const stepsContainer = document.getElementById('steps-container');
    const steps = data.next_steps || data.actionSteps || data.rag?.advice || [];

    if (steps.length > 0 && stepsContainer) {
      stepsBlock?.classList.remove('hidden');
      stepsContainer.innerHTML = '';
      steps.forEach((step, idx) => {
        stepsContainer.innerHTML += `
          <div class="step-row">
            <div class="step-circle">${idx + 1}</div>
            <p class="step-instruction">${escapeHtml(step)}</p>
          </div>
        `;
      });
    } else if (stepsContainer) {
      // Default fallback if empty
      stepsContainer.innerHTML = `
        <div class="step-row">
          <div class="step-circle">1</div>
          <p class="step-instruction">Please verify this through official contact details from your provider or institution.</p>
        </div>
      `;
    }

    // Reveal and scroll smoothly
    section.classList.remove('hidden');
    requestAnimationFrame(() => {
      section.style.opacity = '1';
      section.style.transform = 'translateY(0)';
    });
    setTimeout(() => {
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 120);
  };

  // Start Scanning Button: refreshes the page and scrolls to the scanner input
  window.startScanningAgain = function() {
    window.location.href = '/#scanner';
    window.location.reload();
  };

  // Automatically scroll to scanner if loaded with #scanner hash
  window.addEventListener('DOMContentLoaded', () => {
    if (window.location.hash === '#scanner') {
      setTimeout(() => {
        const el = document.getElementById('scanner');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 200);
    }
  });
</script>

<style>
  .result-section {
    padding: 30px 20px 80px;
    background: var(--canvas, #FFFFFF);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .result-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .result-card {
    background: #FFFFFF;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(26, 13, 63, 0.06), 0 1px 3px rgba(0, 0, 0, 0.04);
    border: 1px solid #ECECF0;
  }

  /* Full-Width Top Banner Header */
  .result-banner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 32px;
    background: #E2DEE9;
    transition: background 0.3s ease;
  }

  .banner-icon-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #9994A5;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .banner-title {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 1.95rem);
    font-weight: 800;
    color: #1A0D3F;
    letter-spacing: -0.02em;
    line-height: 1.2;
    font-family: inherit;
  }

  /* Body Content */
  .result-body {
    padding: 32px 32px 36px;
  }

  .content-block {
    margin-bottom: 24px;
  }

  .block-heading {
    margin: 0 0 12px;
    font-size: 1.15rem;
    font-weight: 700;
    color: #1A0D3F;
    letter-spacing: -0.01em;
  }

  .block-text {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: #374151;
  }

  .content-divider {
    height: 1px;
    background: #ECECF0;
    margin: 24px 0;
  }

  /* Clean Bullet List */
  .clean-bullet-list {
    margin: 0;
    padding-left: 22px;
    color: #374151;
    font-size: 15px;
    line-height: 1.6;
  }
  .bullet-item {
    margin-bottom: 8px;
  }

  /* OCR Text Box */
  .ocr-text-box {
    background: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    padding: 14px 16px;
    font-family: monospace;
    font-size: 13.5px;
    color: #1F2937;
    white-space: pre-wrap;
    max-height: 180px;
    overflow-y: auto;
  }

  /* Steps Container */
  .steps-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .step-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .step-circle {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #1A0D3F;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .step-instruction {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: #374151;
  }

  /* Footer Actions */
  .result-footer-actions {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid #ECECF0;
    display: flex;
    justify-content: flex-start;
  }

  .start-scanning-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #1A0D3F;
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    border: none;
    border-radius: 12px;
    padding: 14px 28px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(26, 13, 63, 0.15);
  }

  .start-scanning-btn:hover {
    background: #2D1B69;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(26, 13, 63, 0.25);
  }

  .safe-disclaimer {
    text-align: center;
    font-size: 12.5px;
    color: #9CA3AF;
    margin: 20px auto 0;
    max-width: 650px;
    line-height: 1.5;
  }

  .hidden { display: none !important; }

  @media (max-width: 640px) {
    .result-banner { padding: 20px 20px; gap: 12px; }
    .banner-title { font-size: 1.45rem; }
    .result-body { padding: 24px 20px; }
    .start-scanning-btn { width: 100%; justify-content: center; }
  }
</style>
