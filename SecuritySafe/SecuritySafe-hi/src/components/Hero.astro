---
// src/components/Hero.astro
---

<section class="hero-top">
  <div class="hero-top-inner">
    <div class="hero-top-content">
      <h1 class="hero-title">Is this message a scam?</h1>
      <p class="hero-subtitle">Check before you tap or pay.</p>
    </div>
  </div>
</section>

<style>
  .hero-top {
    position: relative;
    padding: 30px 16px 14px;
    background: transparent;
    text-align: center;
    z-index: 1;
  }
  .hero-top-inner {
    max-width: 960px;
    margin: 0 auto;
    width: 100%;
  }
  .hero-top-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .hero-title {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: #0F172A;
    margin: 0;
  }
  .hero-subtitle {
    font-size: 16px;
    font-weight: 500;
    color: #64748B;
    margin: 0;
    line-height: 1.35;
  }

  @media (min-width: 640px) {
    .hero-top {
      padding: 40px 20px 20px;
    }
    .hero-title {
      font-size: 32px;
    }
    .hero-subtitle {
      font-size: 17px;
    }
  }
</style>