---
export interface Props {
  currentPage?: string;
}

const { currentPage = 'home' } = Astro.props;

// Clean, minimalist navigation: Scan, Investigate, Learn, Blogs, Emergency
const navItems = [
  { id: 'scan', label: 'Scan', path: '/#scanner' },
  { id: 'investigate', label: 'Investigate', path: '/#investigate' },
  { id: 'learn', label: 'Learn', path: '/learn' },
  { id: 'blogs', label: 'Blogs', path: '/blogs' },
  { id: 'emergency', label: 'Emergency', path: '/emergency' },
];
---

<nav class="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="M9 12l2 2 4-4" stroke-width="2.5"/>
      </svg>
      <span class="nav-logo-text">SAFE</span>
    </a>

    <!-- Navigation Links -->
    <div class="nav-links" id="navLinks">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            class:list={{ 'nav-link': true, active: currentPage === item.id }}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="nav-actions">
      <!-- Mobile Menu Button -->
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Sidebar Overlay -->
<div class="mobile-nav-overlay" id="mobileNavOverlay">
  <div class="mobile-nav-sidebar" id="mobileNavSidebar">
    <div class="mobile-nav-header">
      <a href="/" class="nav-logo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4" stroke-width="2.5"/>
        </svg>
        <span class="nav-logo-text">SAFE</span>
      </a>
      <button class="nav-close" id="navClose" aria-label="Close menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <ul class="mobile-nav-links">
      {
        navItems.map((item) => (
          <li>
            <a 
              href={item.path} 
              class:list={{ 'mobile-link': true, active: currentPage === item.id }}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mobile-nav-footer">
      <a href="tel:1930" class="mobile-helpline-link">
        <strong>Dial 1930</strong>
        <span>National Cyber Crime Helpline</span>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const navClose = document.getElementById('navClose');
  const overlay = document.getElementById('mobileNavOverlay');

  function openMenu() {
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  mobileBtn?.addEventListener('click', openMenu);
  navClose?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeMenu();
  });

  // Handle in-page investigation and scan switching if on home page
  document.querySelectorAll('a[href$="#investigate"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const path = window.location.pathname;
      if (path === '/' || path === '' || path === '/index.html') {
        e.preventDefault();
        window.history.pushState(null, '', '#investigate');
        if (typeof window.switchScannerTab === 'function') {
          window.switchScannerTab('investigate');
        }
        const el = document.getElementById('scanner');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        closeMenu();
      }
    });
  });

  document.querySelectorAll('a[href$="#scanner"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const path = window.location.pathname;
      if (path === '/' || path === '' || path === '/index.html') {
        e.preventDefault();
        window.history.pushState(null, '', '#scanner');
        if (typeof window.switchScannerTab === 'function') {
          window.switchScannerTab('text');
        }
        const el = document.getElementById('scanner');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        closeMenu();
      }
    });
  });
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 64px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-light, #E5E7EB);
    z-index: 100;
  }
  .nav-inner {
    max-width: 1200px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #0A0A0A;
  }
  .nav-logo svg {
    color: #10B981;
  }
  .nav-logo-text {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    background: #F3F4F6;
    padding: 4px;
    border-radius: 100px;
    border: 1px solid #E5E7EB;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 6px 16px;
    font-size: 13.5px;
    font-weight: 600;
    color: #4B5563;
    text-decoration: none;
    border-radius: 100px;
    transition: all 0.15s ease;
  }
  .nav-link:hover {
    color: #0A0A0A;
  }
  .nav-link.active {
    background: #FFFFFF;
    color: #0A0A0A;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .nav-emergency-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #FEE2E2;
    color: #DC2626;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 100px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .nav-emergency-btn:hover {
    background: #FECACA;
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: #111827;
  }

  /* Mobile Overlay */
  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .mobile-nav-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-nav-sidebar {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 280px;
    background: #FFFFFF;
    padding: 24px;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-nav-overlay.open .mobile-nav-sidebar {
    transform: translateX(0);
  }
  .mobile-nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
  }
  .nav-close {
    background: none;
    border: none;
    cursor: pointer;
    color: #4B5563;
  }
  .mobile-nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mobile-link {
    display: block;
    padding: 10px 14px;
    font-size: 16px;
    font-weight: 600;
    color: #374151;
    text-decoration: none;
    border-radius: 8px;
  }
  .mobile-link.active, .mobile-link:hover {
    background: #F3F4F6;
    color: #0A0A0A;
  }
  .mobile-nav-footer {
    margin-top: auto;
    padding-top: 24px;
    border-top: 1px solid #E5E7EB;
  }
  .mobile-helpline-link {
    display: flex;
    flex-direction: column;
    background: #FEF2F2;
    border: 1px solid #FCA5A5;
    padding: 12px;
    border-radius: 10px;
    text-decoration: none;
  }
  .mobile-helpline-link strong { color: #DC2626; font-size: 16px; }
  .mobile-helpline-link span { color: #7F1D1D; font-size: 11.5px; }

  @media (max-width: 850px) {
    .nav-links { display: none; }
    .mobile-menu-btn { display: flex; }
  }
</style>
