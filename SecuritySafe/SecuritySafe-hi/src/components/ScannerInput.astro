  window.downloadInvestigationDossierPDF = function() {
    const invData = currentInvestigationData || {};
    const reportText = currentDossierMarkdown || invData.report || invData.markdown_report || '';
    const query = currentTargetQuery || 'Investigation_Target';

    // Verify jsPDF availability
    const { jsPDF } = window.jspdf || {};
    if (!jsPDF) {
      window.print();
      return;
    }

    try {
      const doc = new jsPDF({
        orientation: 'portrait',
        unit: 'mm',
        format: 'a4',
        compress: true
      });

      const pageWidth = doc.internal.pageSize.getWidth(); // 210mm
      const pageHeight = doc.internal.pageSize.getHeight(); // 297mm
      const margin = 14;
      const contentWidth = pageWidth - (margin * 2);
      let y = 14;

      const dateStr = new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
      const timeStr = new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
      const reportId = 'DOS-' + Math.floor(100000 + Math.random() * 900000);

      function checkPage(needed) {
        if (y + needed > pageHeight - 16) {
          doc.addPage();
          y = 18;
          drawRunningHeader();
          return true;
        }
        return false;
      }

      function drawRunningHeader() {
        doc.setDrawColor(226, 232, 240);
        doc.setLineWidth(0.4);
        doc.line(margin, 12, pageWidth - margin, 12);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(7.5);
        doc.setTextColor(100, 116, 139);
        doc.text('SAFE INVESTIGATION INTELLIGENCE REPORT', margin, 8.5);
        doc.setFont('helvetica', 'normal');
        doc.text(`Target: "${query}"  •  ID: ${reportId}  •  ${dateStr}`, pageWidth - margin, 8.5, { align: 'right' });
      }

      // 1. SIMPLE NORMAL WHITE HEADER (NO BLACK BANNER)
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(16);
      doc.setTextColor(15, 23, 42);
      doc.text('Investigation Intelligence Report', margin, y + 4);

      doc.setFont('helvetica', 'normal');
      doc.setFontSize(8.5);
      doc.setTextColor(100, 116, 139);
      doc.text(`Target: ${query}   |   Generated: ${dateStr} ${timeStr}   |   Live Webhook Intelligence`, margin, y + 10);

      // Clean divider line below header
      doc.setDrawColor(226, 232, 240);
      doc.setLineWidth(0.5);
      doc.line(margin, y + 14, pageWidth - margin, y + 14);
      y += 20;

      // 2. LIVE COMPOSITE SCORECARD
      const compositeVal = typeof invData.composite === 'number' ? invData.composite : (typeof invData.risk_score === 'number' ? invData.risk_score : 54.1);
      const isCritical = compositeVal >= 70;
      const isWarning = compositeVal >= 40 && compositeVal < 70;

      const cardHeight = 26;
      doc.setFillColor(248, 250, 252);
      doc.setDrawColor(226, 232, 240);
      doc.setLineWidth(0.4);
      doc.roundedRect(margin, y, contentWidth, cardHeight, 2, 2, 'FD');

      doc.setFont('helvetica', 'bold');
      doc.setFontSize(7.5);
      doc.setTextColor(100, 116, 139);
      doc.text('AUDIT SUBJECT', margin + 6, y + 7);

      doc.setFont('helvetica', 'bold');
      doc.setFontSize(11);
      doc.setTextColor(15, 23, 42);
      const targetLines = doc.splitTextToSize(`"${query}"`, contentWidth - 55);
      doc.text(targetLines[0], margin + 6, y + 13.5);

      doc.setFont('helvetica', 'normal');
      doc.setFontSize(7.5);
      doc.setTextColor(71, 85, 105);
      doc.text(`Sources: YouTube Comments, Audience Sentiment & Cross-Platform Signals`, margin + 6, y + 19.5);

      // Status Pill on Right
      const scoreW = 44;
      const scoreH = 18;
      const scoreX = pageWidth - margin - scoreW - 4;
      doc.setFillColor(16, 185, 129);
      doc.roundedRect(scoreX, y + 4, scoreW, scoreH, 2, 2, 'F');

      doc.setFont('helvetica', 'bold');
      doc.setFontSize(6.5);
      doc.setTextColor(255, 255, 255);
      doc.text('AUDIT STATUS', scoreX + (scoreW / 2), y + 8.5, { align: 'center' });

      doc.setFont('helvetica', 'bold');
      doc.setFontSize(10);
      doc.text('REPORT READY', scoreX + (scoreW / 2), y + 15, { align: 'center' });

      y += cardHeight + 8;

      // 3. RENDER LIVE REPORT SECTIONS PURELY FROM JSON / MARKDOWN
      if (reportText) {
        let pdfMentionCounter = 0;
        const lines = reportText.split('\n');
        for (let i = 0; i < lines.length; i++) {
          const rawLine = lines[i];
          const line = rawLine.trim();
          if (!line) {
            y += 2.5;
            continue;
          }

          if (line.startsWith('# ') || line.startsWith('---')) {
            continue;
          }

          // Section Heading (## ...)
          if (line.startsWith('## ')) {
            checkPage(16);
            y += 4;
            const headingText = line.replace(/^##\s*/, '').replace(/^[^\w\s]+/, '').trim();
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(10.5);
            doc.setTextColor(15, 23, 42);
            doc.text(headingText, margin, y);
            y += 2.5;
            doc.setDrawColor(226, 232, 240);
            doc.setLineWidth(0.3);
            doc.line(margin, y, margin + 45, y);
            y += 4.5;
            continue;
          }

          // Subheading (### ...)
          if (line.startsWith('### ')) {
            checkPage(12);
            y += 3;
            const subTitle = line.replace(/^###\s*/, '').replace(/^[^\w\s]+/, '').trim();
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(9.5);
            doc.setTextColor(15, 23, 42);
            doc.text(subTitle, margin, y);
            y += 4;
            continue;
          }

          // Comment Sample Category Header (**Organic Positive...**)
          if (/^\*\*(Organic Positive|Organic Negative|Organic Neutral|Filtered Bot)/i.test(line)) {
            checkPage(11);
            const isPos = /Positive/i.test(line);
            const isNeg = /Negative/i.test(line);
            const isNeu = /Neutral/i.test(line);
            const isFil = /Filtered/i.test(line);

            let catColor = [71, 85, 105];
            if (isPos) catColor = [16, 185, 129];
            else if (isNeg) catColor = [220, 38, 38];
            else if (isNeu) catColor = [37, 99, 235];
            else if (isFil) catColor = [217, 119, 6];

            const labelText = line.replace(/\*\*/g, '').replace(/:$/, '').trim();
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(8);
            doc.setTextColor(catColor[0], catColor[1], catColor[2]);
            doc.text(labelText, margin + 2, y);
            y += 4;
            continue;
          }

          // Comment Quotes in PDF (- "...")
          if (/^[-*]\s*["“]/.test(line)) {
            checkPage(10);
            let quoteText = line.replace(/^[-*]\s*/, '').trim();
            // Sanitize emojis / non-Latin characters for standard jsPDF helvetica font
            quoteText = quoteText.replace(/[^\x20-\x7E\u00A0-\u00FF]/g, '').replace(/\s+/g, ' ').trim();
            doc.setFont('helvetica', 'italic');
            doc.setFontSize(7.8);
            doc.setTextColor(51, 65, 85);
            const wrapped = doc.splitTextToSize(quoteText, contentWidth - 10);
            doc.text(wrapped, margin + 6, y);
            y += (wrapped.length * 3.8) + 2.5;
            continue;
          }

          // Table Rows (| ... |)
          if (line.startsWith('|') && line.endsWith('|')) {
            if (/^\|[-:\s|]+\|$/.test(line)) {
              continue;
            }
            const cells = line.split('|').slice(1, -1).map(c => c.replace(/\*\*/g, '').trim());
            checkPage(7.5);

            const numCols = cells.length;
            const colW = contentWidth / numCols;

            doc.setFont('helvetica', 'normal');
            doc.setFontSize(8);
            doc.setTextColor(51, 65, 85);
            cells.forEach((cell, cIdx) => {
              doc.text(cell, margin + (cIdx * colW) + 2, y);
            });
            y += 5;
            continue;
          }

          // External Mention lines in PDF (- [negative] ... or - [positive] ... or - [neutral] ...)
          const isMentionLine = /^[-*]\s*\[(negative|positive|neutral)\]/i.test(line);
          if (isMentionLine) {
            checkPage(9);
            const isNeg = /\[negative\]/i.test(line);
            const isPos = /\[positive\]/i.test(line);

            // Red, Green, Black styling
            let tagColor = [15, 23, 42]; // Black/Dark Slate for Media/Neutral
            let tagLabel = '• [MEDIA COVERAGE]';
            if (isNeg) {
              tagColor = [220, 38, 38]; // Red for Warning
              tagLabel = '• [IMPORTANT TO WATCH BEFORE BUYING]';
            } else if (isPos) {
              tagColor = [22, 163, 74]; // Green for Verified
              tagLabel = '• [VERIFIED RECORD]';
            }

            // Extract link and clean title
            let linkUrl = '';
            let rawText = line.replace(/^[-*]\s*\[(negative|positive|neutral)\]/i, '').trim();
            const mdLinkMatch = rawText.match(/\[(.*?)\]\((https?:\/\/[^\s)]+)\)/);
            if (mdLinkMatch) {
              rawText = rawText.replace(mdLinkMatch[0], mdLinkMatch[1]);
              linkUrl = mdLinkMatch[2];
            }

            let title = rawText;
            let domain = '';
            if (rawText.includes('—')) {
              const parts = rawText.split('—');
              title = parts[0].trim();
              domain = parts.slice(1).join('—').trim();
            } else if (rawText.includes('--')) {
              const parts = rawText.split('--');
              title = parts[0].trim();
              domain = parts.slice(1).join('--').trim();
            }

            // Sanitize title and domain of emojis/corrupt Unicode symbols
            title = title
              .replace(/\*\*/g, '')
              .replace(/[^\x20-\x7E\u00A0-\u00FF]/g, ' ')
              .replace(/\s+/g, ' ')
              .trim();

            domain = domain
              .replace(/\*\*/g, '')
              .replace(/[^\x20-\x7E\u00A0-\u00FF]/g, ' ')
              .replace(/\s+/g, ' ')
              .trim();

            const cleanDomain = domain.replace(/^https?:\/\//i, '').replace(/\/.*$/, '').trim();

            // Match exact link from invData.externalMentions (actual source webpage URL)
            const extMentions = invData.externalMentions || [];
            if (!linkUrl && extMentions.length > pdfMentionCounter && extMentions[pdfMentionCounter]?.link) {
              linkUrl = extMentions[pdfMentionCounter].link;
            } else if (!linkUrl && extMentions.length > 0) {
              const foundObj = extMentions.find(m => m.title && (title.includes(m.title.slice(0, 20)) || m.title.includes(title.slice(0, 20))));
              if (foundObj && foundObj.link) linkUrl = foundObj.link;
            }
            if (!linkUrl && cleanDomain) {
              linkUrl = 'https://' + cleanDomain;
            }
            pdfMentionCounter++;

            // 1. Draw Tag in Red / Green / Black
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(8);
            doc.setTextColor(tagColor[0], tagColor[1], tagColor[2]);
            doc.text(tagLabel, margin + 2, y);

            const tagWidth = doc.getTextWidth(tagLabel) + 2.5;

            // 2. Format title and source suffix
            const sourceSuffix = cleanDomain ? ` — ${cleanDomain}` : '';
            const fullTitle = `${title}${sourceSuffix}`;
            const maxTitleWidth = contentWidth - tagWidth - 4;

            doc.setFont('helvetica', 'normal');
            doc.setFontSize(8);
            // Hyperlink blue color
            doc.setTextColor(29, 78, 216);

            const wrappedTitle = doc.splitTextToSize(fullTitle, maxTitleWidth);
            const itemHeight = Math.max(5, wrappedTitle.length * 4.2);

            for (let tIdx = 0; tIdx < wrappedTitle.length; tIdx++) {
              const lineY = y + (tIdx * 4.2);
              const lineX = margin + 2 + tagWidth;
              if (linkUrl) {
                doc.textWithLink(wrappedTitle[tIdx], lineX, lineY, { url: linkUrl });
              } else {
                doc.text(wrappedTitle[tIdx], lineX, lineY);
              }
            }

            // Clickable hotspot over the whole mention row in PDF
            if (linkUrl) {
              doc.link(margin, y - 3.5, contentWidth, itemHeight + 1.5, { url: linkUrl });
            }

            y += itemHeight + 2;
            continue;
          }

          // Bullet Items (- ...)
          if (line.startsWith('- ') || line.startsWith('* ')) {
            checkPage(7.5);
            const bulletText = line.replace(/^[-*]\s*/, '').replace(/\*\*/g, '').trim();
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(8);
            doc.setTextColor(16, 185, 129);
            doc.text('•', margin + 2, y);

            doc.setFont('helvetica', 'normal');
            doc.setFontSize(8);
            doc.setTextColor(51, 65, 85);
            const wrapped = doc.splitTextToSize(bulletText, contentWidth - 8);
            doc.text(wrapped, margin + 7, y);
            y += (wrapped.length * 4.2) + 2;
            continue;
          }

          // Regular Paragraphs
          checkPage(7.5);
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(8);
          doc.setTextColor(71, 85, 105);
          const cleanP = line.replace(/\*\*/g, '');
          const wrapped = doc.splitTextToSize(cleanP, contentWidth);
          doc.text(wrapped, margin, y);
          y += (wrapped.length * 4.2) + 2;
        }
      }

      // Footer
      checkPage(12);
      y += 6;
      doc.setDrawColor(226, 232, 240);
      doc.setLineWidth(0.3);
      doc.line(margin, y, pageWidth - margin, y);
      y += 5;
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(7);
      doc.setTextColor(148, 163, 184);
      doc.text('Automated Scam & Threat Intelligence Audit • SAFE Defense Core • verify at cybercrime.gov.in (1930)', margin, y);

      const filename = `Investigation_Report_${query.replace(/[^a-zA-Z0-9]/g, '_').slice(0, 30)}.pdf`;
      doc.save(filename);
    } catch (pdfErr) {
      console.error('PDF generation error:', pdfErr);
      window.print();
    }
  };
</script>

