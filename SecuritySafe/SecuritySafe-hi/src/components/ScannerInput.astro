---
// src/components/ScannerInput.astro
const MAIN_API = import.meta.env.PUBLIC_MAIN_API_URL || 'https://ixil3ly75uaxbvmqzs6mdlfj4m0kdtud.lambda-url.us-east-1.on.aws';
---

<section class="scanner-section" id="scanner">
  <div class="scanner-container">
    <!-- Scanner Card -->
    <div class="scanner-card">
      <!-- Clean Responsive Segmented Control: Run Investigation | Text | Image -->
      <div class="scanner-tabs">
        <button id="tab-btn-investigate" class="tab-btn active" onclick="switchScannerTab('investigate')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <span class="tab-text-desktop">Run Investigation</span>
          <span class="tab-text-mobile">Run Investigation</span>
        </button>

        <button id="tab-btn-text" class="tab-btn" onclick="switchScannerTab('text')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <span class="tab-text-desktop">Text</span>
          <span class="tab-text-mobile">Text</span>
        </button>

        <button id="tab-btn-image" class="tab-btn" onclick="switchScannerTab('image')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
          <span class="tab-text-desktop">Image</span>
          <span class="tab-text-mobile">Image</span>
        </button>
      </div>

      <div class="scanner-body">
        <!-- Input Form Panels -->
        <div class="forms-panel">
          <!-- 1. Investigate Panel (YouTube Intelligence, Heuristic Signals & Threat Dossier) -->
          <div id="form-investigate" class="channel-form active">
            <div class="investigate-intro">
              <h3 class="investigate-title">YouTube Creator & Threat Intelligence Audit</h3>
              <p class="investigate-desc">Audit any YouTube creator or scheme via AI bot comment analysis, engagement anomalies, and cross-platform verification.</p>
            </div>

            <div class="investigate-input-row">
              <div class="search-bar-wrapper">
                <svg class="search-bar-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
                  <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="currentColor"/>
                </svg>
                <input
                  type="text"
                  id="investigate-query-input"
                  class="investigate-input"
                  placeholder="Paste YouTube channel link or video (e.g., https://youtube.com/@dhruvrathee or watch?v=...)"
                  onkeydown="if(event.key === 'Enter') startInvestigate();"
                />
              </div>
              <button id="investigate-btn" class="investigate-action-btn" onclick="startInvestigate()">
                <span>Run Investigation</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </button>
            </div>
            <div id="investigate-validation-msg" class="validation-msg hidden">Please enter a valid YouTube channel or video link (e.g., youtube.com/@dhruvrathee, youtube.com/watch?v=..., or youtu.be/...).</div>

            <div class="quick-tags-row">
              <span class="quick-tags-label">Quick Test:</span>
              <button type="button" class="quick-tag-chip" onclick="setInvestigateQuery('https://www.youtube.com/@dhruvrathee')">Dhruv Rathee</button>
            </div>

            <!-- Clean Single-Line Minimal Loader: left loading bar + changing black text (background-less) -->
            <div id="investigate-loader" class="investigate-minimal-loader hidden">
              <div class="loader-mini-bar-track">
                <div class="loader-mini-bar-thumb"></div>
              </div>
              <span id="investigate-loading-text" class="investigate-loading-text">Resolving creator and channel domain...</span>
            </div>

            <!-- Abstracted Threat Intelligence Results (NO VIDEOS) -->
            <div id="investigate-results-box" class="investigate-results-box hidden">
              <!-- Top Executive Bar -->
              <div class="investigate-header-card">
                <div class="header-status-left">
                  <span class="status-indicator-dot" id="dossier-status-dot"></span>
                  <div>
                    <h4 class="dossier-target" id="dossier-target">Investigation Report</h4>
                    <div class="dossier-meta-row">
                      <span class="dossier-pill" id="dossier-domain-pill">Domain: general</span>
                      <span class="dossier-pill" id="dossier-sources-pill">Sources: YouTube, Web</span>
                      <span class="dossier-pill highlight" id="dossier-coverage-pill">Coverage: 100 comments · 20 videos · 15 mentions</span>
                    </div>
                  </div>
                </div>
                <div class="header-status-right">
                  <button class="btn-download-dossier" onclick="downloadInvestigationDossierPDF()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                      <polyline points="7 10 12 15 17 10"/>
                      <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    Download PDF
                  </button>
                  <button class="btn-new-audit" onclick="resetInvestigation()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="1 4 1 10 7 10"/>
                      <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                    </svg>
                    New Audit
                  </button>
                </div>
              </div>

              <!-- Signal Synthesis & Reasoning Banner (No Composite Score) -->
              <div class="composite-overview-card report-mode">
                <div class="composite-reasoning-col">
                  <div class="reasoning-header-row">
                    <h5 class="reasoning-title">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="16" x2="12" y2="12"/>
                        <line x1="12" y1="8" x2="12.01" y2="8"/>
                      </svg>
                      AI Signal Synthesis & Reasoning Report
                    </h5>
                    <span class="guardrail-badge" id="guardrail-status-tag">✓ AI Guardrails Passed</span>
                  </div>
                  <p class="reasoning-text" id="composite-reasoning-text">Comment quality is high with low fake ratios, but engagement metrics show anomalies. External signals balance organic sentiment with third-party reports.</p>
                  <div class="guardrail-details-bar" id="guardrail-details-bar">
                    <span class="gd-item">✓ Both Sides Represented</span>
                    <span class="gd-item">✓ No Verdict Leakage</span>
                    <span class="gd-item">✓ Heuristic Boundaries Enforced</span>
                    <span class="gd-item">✓ Descriptive Signal Analysis</span>
                  </div>
                </div>
              </div>

              <!-- Balanced Signals: Side-by-Side Cards -->
              <div class="balanced-signals-grid">
                <!-- Left: Questioned Signals -->
                <div class="signal-card questioned-card">
                  <div class="signal-card-header">
                    <div class="signal-card-title-wrap">
                      <span class="signal-icon-box warn">⚠️</span>
                      <div>
                        <h5 class="signal-card-title">Signals Raising Questions</h5>
                        <span class="signal-card-count" id="count-questioned-signals">4 anomalies detected</span>
                      </div>
                    </div>
                  </div>
                  <ul class="signal-list" id="signals-questioned-list">
                    <!-- Populated dynamically -->
                  </ul>
                </div>

                <!-- Right: Supported Signals -->
                <div class="signal-card supported-card">
                  <div class="signal-card-header">
                    <div class="signal-card-title-wrap">
                      <span class="signal-icon-box check">✅</span>
                      <div>
                        <h5 class="signal-card-title">Signals Supporting Credibility</h5>
                        <span class="signal-card-count" id="count-supported-signals">3 positive signals verified</span>
                      </div>
                    </div>
                  </div>
                  <ul class="signal-list" id="signals-supported-list">
                    <!-- Populated dynamically -->
                  </ul>
                </div>
              </div>

              <!-- Forensic Dimension Indicators (0 to 5 rating, no contribution) -->
              <div class="breakdown-card">
                <div class="breakdown-header">
                  <h5 class="breakdown-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="18" y1="20" x2="18" y2="10"/>
                      <line x1="12" y1="20" x2="12" y2="4"/>
                      <line x1="6" y1="20" x2="6" y2="14"/>
                    </svg>
                    Forensic Dimension Indicators
                  </h5>
                  <span class="breakdown-desc">Forensic ratings evaluated on standard 0–5 heuristic signal scales</span>
                </div>
                <div class="breakdown-grid" id="breakdown-cards-grid">
                  <!-- Populated dynamically -->
                </div>
              </div>

              <!-- Intelligence Grid: Comment Stats & Channel Signals -->
              <div class="intel-metrics-grid">
                <!-- Comment Analysis Card -->
                <div class="intel-card">
                  <h5 class="intel-card-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    Comment Integrity Analysis
                  </h5>
                  <div class="comment-stat-bars">
                    <div class="comment-bar-row">
                      <span class="cb-label">Total Sampled</span>
                      <strong class="cb-val" id="cs-total">100 comments</strong>
                    </div>
                    <div class="comment-bar-row">
                      <span class="cb-label">Filtered Bot / Spam</span>
                      <span class="cb-pill warn" id="cs-fake">6 (6.0%)</span>
                    </div>
                    <div class="comment-bar-row">
                      <span class="cb-label">Organic Positive</span>
                      <span class="cb-pill pos" id="cs-pos">38.3%</span>
                    </div>
                    <div class="comment-bar-row">
                      <span class="cb-label">Organic Negative</span>
                      <span class="cb-pill neg" id="cs-neg">1.1%</span>
                    </div>
                    <div class="comment-bar-row">
                      <span class="cb-label">Organic Neutral</span>
                      <span class="cb-pill neu" id="cs-neu">60.6%</span>
                    </div>
                  </div>
                  <!-- Visual Distribution Bar -->
                  <div class="comment-dist-bar">
                    <div class="cd-segment pos" id="cd-pos-bar" style="width: 38%" title="Positive: 38%"></div>
                    <div class="cd-segment neu" id="cd-neu-bar" style="width: 61%" title="Neutral: 61%"></div>
                    <div class="cd-segment neg" id="cd-neg-bar" style="width: 1%" title="Negative: 1%"></div>
                  </div>

                  <!-- Representative Comment Samples & Filtered Evidence -->
                  <div class="comment-samples-wrapper" id="comment-samples-wrapper" style="display: none;">
                    <div class="cs-samples-header">
                      <span class="cs-samples-title">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        Filtered & Sentiment Evidence Samples
                      </span>
                      <span class="cs-samples-sub">Top 2–3 quotes per category</span>
                    </div>
                    <div class="comment-samples-grid" id="comment-samples-grid">
                      <!-- Rendered dynamically by JS -->
                    </div>
                  </div>
                </div>

                <!-- Engagement Signals Card -->
                <div class="intel-card">
                  <h5 class="intel-card-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                      <polyline points="17 6 23 6 23 12"/>
                    </svg>
                    Engagement & Audience Signals
                  </h5>
                  <div class="metrics-subgrid">
                    <div class="metric-mini-box">
                      <span class="mm-label">Subscribers</span>
                      <strong class="mm-val" id="met-subs">4.54M</strong>
                    </div>
                    <div class="metric-mini-box">
                      <span class="mm-label">Avg Views</span>
                      <strong class="mm-val" id="met-views">386K</strong>
                    </div>
                    <div class="metric-mini-box">
                      <span class="mm-label">Like-to-View</span>
                      <strong class="mm-val" id="met-like-view">0.98%</strong>
                      <span class="mm-typical">Typical: 1–5%</span>
                    </div>
                    <div class="metric-mini-box">
                      <span class="mm-label">Comment-to-View</span>
                      <strong class="mm-val" id="met-comm-view">0.03%</strong>
                      <span class="mm-typical">Typical: 0.1–0.5%</span>
                    </div>
                    <div class="metric-mini-box">
                      <span class="mm-label">Sub-to-View</span>
                      <strong class="mm-val" id="met-sub-view">11.75x</strong>
                      <span class="mm-typical">Typical: 1–5x</span>
                    </div>
                    <div class="metric-mini-box">
                      <span class="mm-label">View Stability</span>
                      <strong class="mm-val" id="met-stability">0%</strong>
                      <span class="mm-typical">Typical: &gt; 50%</span>
                    </div>
                  </div>
                  <!-- Red flags list -->
                  <div class="redflags-box">
                    <span class="rf-title">Flagged Discrepancies:</span>
                    <div class="rf-chips" id="metrics-redflags-chips">
                      <span class="rf-chip">sub_to_view_above_typical</span>
                      <span class="rf-chip">comment_ratio_below_typical</span>
                      <span class="rf-chip">view_volatility_high</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- External Mentions & Third-Party Audit (NO VIDEOS) -->
              <div class="mentions-card">
                <div class="mentions-header">
                  <h5 class="mentions-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="11" cy="11" r="8"/>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    Third-Party Mentions & Public Record Search
                  </h5>
                  <span class="mentions-sub">Extracted web mentions, news articles, and community references</span>
                </div>
                <div class="mentions-list" id="external-mentions-list">
                  <!-- Populated dynamically -->
                </div>
              </div>

              <!-- Methodology & Actionable Verification Protocol -->
              <div class="action-footer-grid">
                <div class="footer-box limitations-box">
                  <h6 class="fb-title">🧾 Methodology & Limitations</h6>
                  <ul class="fb-list">
                    <li>Top 100 comments analyzed using linguistic & bot pattern heuristics.</li>
                    <li>Not a legal ruling or fraud verdict; probabilistic indicator of risk density.</li>
                    <li>Evaluates channel metrics against industry baselines and cross-platform mentions.</li>
                  </ul>
                </div>
                <div class="footer-box protocol-box">
                  <h6 class="fb-title">💡 Independent Verification Protocol</h6>
                  <p class="fb-desc">Before investing funds or taking financial actions based on this entity, verify via official statutory bodies:</p>
                  <div class="fb-links">
                    <a href="https://factcheck.pib.gov.in" target="_blank" rel="noopener noreferrer" class="fb-link">PIB Fact Check ↗</a>
                    <a href="https://www.sebi.gov.in" target="_blank" rel="noopener noreferrer" class="fb-link">SEBI Registry ↗</a>
                    <a href="https://cybercrime.gov.in" target="_blank" rel="noopener noreferrer" class="fb-link alert-link">National Cybercrime (1930) ↗</a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 2. Text / Message Panel -->
          <div id="form-text" class="channel-form">
            <div class="input-wrapper">
              <textarea
                id="scan-text-input"
                class="scan-textarea"
                rows="4"
                placeholder="Paste any suspicious message, SMS, email, WhatsApp chat, call details, or link here..."
              ></textarea>
            </div>
            <button id="scan-text-btn" class="analyze-btn" onclick="startTextScan()">
              <span>Check Message for Scams</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </div>

          
          <!-- 3. Image / Photo Panel -->
          <div id="form-image" class="channel-form">
            <div class="image-upload-zone" id="image-drop-zone" onclick="triggerFileInput()">
              <input
                type="file"
                id="scan-image-input"
                class="file-input-hidden"
                accept="image/png, image/jpeg, image/jpg, image/webp"
                onchange="handleImageSelected(event)"
              />
              
              <div id="image-empty-state" class="upload-empty-state">
                <div class="upload-icon-circle">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="17 8 12 3 7 8"/>
                    <line x1="12" y1="3" x2="12" y2="15"/>
                  </svg>
                </div>
                <h4 class="upload-heading">Click or drag & drop image here</h4>
                <p class="upload-subtext">Screenshots, fake payment slips, unverified letters, ID cards, profile pictures</p>
                <div class="ocr-feature-badge">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="4 7 4 4 20 4 20 7"/>
                    <line x1="9" y1="20" x2="15" y2="20"/>
                    <line x1="12" y1="4" x2="12" y2="20"/>
                  </svg>
                  <span>Reads visible text + Checks for manipulated photos & fake slips</span>
                </div>
              </div>

              <!-- Preview State -->
              <div id="image-preview-state" class="upload-preview-state hidden">
                <img id="image-preview-thumb" src="" alt="Uploaded preview" class="preview-thumb" />
                <div class="preview-meta">
                  <span id="preview-filename" class="preview-filename">image.jpg</span>
                  <span id="preview-filesize" class="preview-filesize">0 KB</span>
                  <button type="button" class="remove-image-btn" onclick="clearSelectedImage(event)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="18" y1="6" x2="6" y2="18"/>
                      <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                    Remove
                  </button>
                </div>
              </div>
            </div>

            <button id="scan-image-btn" class="analyze-btn" onclick="startImageScan()" disabled>
              <span>Check Photo for Manipulations & Fraud</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </div>

          
        </div>

        <!-- Animated Loader -->
        <div id="scanner-loader" class="scanner-loader hidden">
          <div class="loader-header">
            <div class="loader-spinner"></div>
            <h3 class="loader-title" id="loader-title">Analyzing for safety risks...</h3>
          </div>
          <div class="loader-steps">
            <div class="loader-step pending" id="step-upload">
              <div class="step-status"><div class="spinner-small"></div><span class="check-icon">✓</span></div>
              <div class="step-text"><strong class="step-heading" id="step-upload-title">Processing input</strong><span class="step-desc" id="step-upload-desc">Receiving and preparing your message</span></div>
            </div>
            <div class="loader-step pending" id="step-risks">
              <div class="step-status"><div class="spinner-small"></div><span class="check-icon">✓</span></div>
              <div class="step-text"><strong class="step-heading" id="step-risks-title">Checking for risks</strong><span class="step-desc" id="step-risks-desc">Analyzing links, numbers, and pressure tactics</span></div>
            </div>
            <div class="loader-step pending" id="step-flags">
              <div class="step-status"><div class="spinner-small"></div><span class="check-icon">✓</span></div>
              <div class="step-text"><strong class="step-heading" id="step-flags-title">Detecting red flags</strong><span class="step-desc" id="step-flags-desc">Evaluating against high-frequency scam patterns</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Helper hint -->
    <p class="scanner-hint" id="scanner-hint">
      💡 Tip: Paste any YouTube link to audit comments, bot activity, and creator credibility.
    </p>
  </div>
</section>

<script define:vars={{ MAIN_API }}>
  const API_BASE = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')
    ? 'http://127.0.0.1:8000'
    : (MAIN_API || 'https://ixil3ly75uaxbvmqzs6mdlfj4m0kdtud.lambda-url.us-east-1.on.aws');

  let activeTab = 'investigate';
  let selectedFile = null;
  let currentDossierMarkdown = '';
  let currentTargetQuery = '';
  let currentInvestigationData = null;

  window.switchScannerTab = function(tab) {
    activeTab = tab;
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.channel-form').forEach(f => f.classList.remove('active'));

    if (tab === 'investigate') {
      document.getElementById('tab-btn-investigate')?.classList.add('active');
      document.getElementById('form-investigate')?.classList.add('active');
      const hint = document.getElementById('scanner-hint');
      if (hint) hint.textContent = '💡 Tip: Paste any YouTube link to audit comments, bot activity, and creator credibility.';
    } else if (tab === 'text') {
      document.getElementById('tab-btn-text')?.classList.add('active');
      document.getElementById('form-text')?.classList.add('active');
      const hint = document.getElementById('scanner-hint');
      if (hint) hint.textContent = '💡 Tip: Paste the full message or link for the most accurate scam analysis.';
    } else if (tab === 'image') {
      document.getElementById('tab-btn-image')?.classList.add('active');
      document.getElementById('form-image')?.classList.add('active');
      const hint = document.getElementById('scanner-hint');
      if (hint) hint.textContent = '💡 Tip: Screenshots, payment slips, fake letters, and profile pictures are analyzed for fraudulent patterns.';
    }
  };

  function checkUrlHash() {
    if (window.location.hash === '#investigate') {
      window.switchScannerTab('investigate');
      const scannerEl = document.getElementById('scanner');
      if (scannerEl) scannerEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => {
        document.getElementById('investigate-query-input')?.focus();
      }, 250);
    } else if (window.location.hash === '#text' || window.location.hash === '#message') {
      window.switchScannerTab('text');
      const scannerEl = document.getElementById('scanner');
      if (scannerEl) scannerEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else if (window.location.hash === '#image' || window.location.hash === '#photo') {
      window.switchScannerTab('image');
      const scannerEl = document.getElementById('scanner');
      if (scannerEl) scannerEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else if (window.location.hash === '#scanner' || window.location.hash === '#scan') {
      window.switchScannerTab('investigate');
      const scannerEl = document.getElementById('scanner');
      if (scannerEl) scannerEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  window.addEventListener('hashchange', checkUrlHash);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkUrlHash);
  } else {
    checkUrlHash();
  }

  window.setInvestigateQuery = function(text) {
    const input = document.getElementById('investigate-query-input');
    if (input) {
      input.value = text;
      startInvestigate();
    }
  };

  window.triggerFileInput = function() {
    const input = document.getElementById('scan-image-input');
    if (input) input.click();
  };

  window.handleImageSelected = function(e) {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    setUploadedFile(file);
  };

  function setUploadedFile(file) {
    selectedFile = file;
    const emptyState = document.getElementById('image-empty-state');
    const previewState = document.getElementById('image-preview-state');
    const previewThumb = document.getElementById('image-preview-thumb');
    const nameEl = document.getElementById('preview-filename');
    const sizeEl = document.getElementById('preview-filesize');
    const btn = document.getElementById('scan-image-btn');

    if (nameEl) nameEl.textContent = file.name;
    if (sizeEl) sizeEl.textContent = `${(file.size / 1024).toFixed(1)} KB`;

    const reader = new FileReader();
    reader.onload = function(evt) {
      if (previewThumb) previewThumb.src = evt.target.result;
      emptyState?.classList.add('hidden');
      previewState?.classList.remove('hidden');
      if (btn) btn.removeAttribute('disabled');
    };
    reader.readAsDataURL(file);
  }

  window.clearSelectedImage = function(e) {
    if (e) e.stopPropagation();
    selectedFile = null;
    const input = document.getElementById('scan-image-input');
    if (input) input.value = '';
    document.getElementById('image-preview-state')?.classList.add('hidden');
    document.getElementById('image-empty-state')?.classList.remove('hidden');
    const btn = document.getElementById('scan-image-btn');
    if (btn) btn.setAttribute('disabled', 'true');
  };

  // Drag & drop support
  const dropZone = document.getElementById('image-drop-zone');
  if (dropZone) {
    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.add('drag-over');
      }, false);
    });
    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.remove('drag-over');
      }, false);
    });
    dropZone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      const file = dt && dt.files && dt.files[0];
      if (file && file.type.startsWith('image/')) {
        setUploadedFile(file);
      }
    }, false);
  }

  const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

  async function runScanFlow(apiCall, isImage = false) {
    const loader = document.getElementById('scanner-loader');
    const formsPanel = document.querySelector('.forms-panel');
    const inputSection = document.getElementById('scanner');

    if (isImage) {
      document.getElementById('step-upload-title').textContent = 'Reading Image & Details';
      document.getElementById('step-upload-desc').textContent = 'Reading visible text and checking format';
      document.getElementById('step-risks-title').textContent = 'Checking Authenticity & Alterations';
      document.getElementById('step-risks-desc').textContent = 'Checking visual cues, layout consistency & signs of tampering';
      document.getElementById('step-flags-title').textContent = 'Scam Intent & Deception Analysis';
      document.getElementById('step-flags-desc').textContent = 'Correlating extracted text with fraud tactics';
    } else {
      document.getElementById('step-upload-title').textContent = 'Processing input';
      document.getElementById('step-upload-desc').textContent = 'Receiving and preparing your message';
      document.getElementById('step-risks-title').textContent = 'Checking for risks';
      document.getElementById('step-risks-desc').textContent = 'Analyzing links, numbers, and pressure tactics';
      document.getElementById('step-flags-title').textContent = 'Detecting red flags';
      document.getElementById('step-flags-desc').textContent = 'Evaluating against high-frequency scam patterns';
    }

    formsPanel?.classList.add('hidden');
    loader?.classList.remove('hidden');

    const setStep = (index, status) => {
      const stepIds = ['step-upload', 'step-risks', 'step-flags'];
      const el = document.getElementById(stepIds[index]);
      if (el) el.className = `loader-step ${status}`;
    };

    setStep(0, 'processing');
    setStep(1, 'pending');
    setStep(2, 'pending');

    const apiPromise = apiCall();

    const stepDuration = isImage ? 1800 : 1500;
    const animationPromise = (async () => {
      await sleep(stepDuration);
      setStep(0, 'checked');
      setStep(1, 'processing');

      await sleep(stepDuration);
      setStep(1, 'checked');
      setStep(2, 'processing');
    })();

    try {
      const [apiResult] = await Promise.all([apiPromise, animationPromise]);
      
      await sleep(800);
      setStep(2, 'checked');
      await sleep(400);

      loader?.classList.add('hidden');

      if (typeof window.renderDetailedResult === 'function') {
        window.renderDetailedResult(apiResult, isImage);
      }

      if (inputSection) {
        inputSection.classList.add('fade-out-up');
        setTimeout(() => {
          inputSection.classList.add('hidden');
        }, 400);
      }
    } catch (err) {
      console.error('Scan failed:', err);
      loader?.classList.add('hidden');
      formsPanel?.classList.remove('hidden');
      alert(err.message || 'Safety scan failed. Please try again.');
    }
  }

  window.startTextScan = function() {
    const input = document.getElementById('scan-text-input');
    const text = input ? input.value.trim() : '';

    if (!text) {
      if (input) {
        input.classList.add('shake');
        input.focus();
        setTimeout(() => input.classList.remove('shake'), 500);
      }
      return;
    }

    runScanFlow(async () => {
      const res = await fetch(`${API_BASE}/api/scan/text`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
      });

      if (!res.ok) {
        const errorData = await res.json().catch(() => ({}));
        throw new Error(errorData.detail || `Server returned error (${res.status})`);
      }
      return await res.json();
    }, false);
  };

  window.startImageScan = function() {
    if (!selectedFile) return;

    runScanFlow(async () => {
      const formData = new FormData();
      formData.append('file', selectedFile);

      const res = await fetch(`${API_BASE}/api/scan/image`, {
        method: 'POST',
        body: formData,
      });

      if (!res.ok) {
        const errorData = await res.json().catch(() => ({}));
        throw new Error(errorData.detail || `Server returned error (${res.status})`);
      }
      return await res.json();
    }, true);
  };

  // ── Investigation Logic (n8n Webhook + Staged 6-Step Engine) ────────────

  window.resetInvestigation = function() {
    const input = document.getElementById('investigate-query-input');
    const resultsBox = document.getElementById('investigate-results-box');
    const loader = document.getElementById('investigate-loader');
    const validationMsg = document.getElementById('investigate-validation-msg');
    if (input) input.value = '';
    resultsBox?.classList.add('hidden');
    loader?.classList.add('hidden');
    validationMsg?.classList.add('hidden');
    input?.focus();
  };

  window.startInvestigate = async function() {
    const input = document.getElementById('investigate-query-input');
    const query = input ? input.value.trim() : '';
    const validationMsg = document.getElementById('investigate-validation-msg');
    const btn = document.getElementById('investigate-btn');
    const loader = document.getElementById('investigate-loader');
    const resultsBox = document.getElementById('investigate-results-box');
    const loadingTextEl = document.getElementById('investigate-loading-text');

    function isYouTubeUrl(str) {
      if (!str) return false;
      const clean = str.trim();
      return /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|c\/|channel\/|@)|youtu\.be\/|^@|^[a-zA-Z0-9_-]{11}$)/i.test(clean);
    }

    if (!query || !isYouTubeUrl(query)) {
      if (validationMsg) validationMsg.classList.remove('hidden');
      input?.focus();
      return;
    }
    validationMsg?.classList.add('hidden');

    currentTargetQuery = query;
    btn?.setAttribute('disabled', 'true');
    resultsBox?.classList.add('hidden');
    loader?.classList.remove('hidden');

    // Single-line rotating black text stages while listening to webhook
    const loadingStages = [
      "Resolving YouTube creator and channel metadata...",
      "Auditing comments and engagement velocity...",
      "Scanning comment sentiment and bot heuristics...",
      "Cross-referencing web mentions and public alerts...",
      "Synthesizing live investigation report..."
    ];
    let stageIdx = 0;
    if (loadingTextEl) loadingTextEl.textContent = loadingStages[0];
    const textInterval = setInterval(() => {
      stageIdx = (stageIdx + 1) % loadingStages.length;
      if (loadingTextEl) loadingTextEl.textContent = loadingStages[stageIdx];
    }, 1500);

    let data = null;

    try {
      // 1. First try configured API_BASE
      let res = null;
      try {
        res = await fetch(`${API_BASE}/api/investigate`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ input: query, query: query, url: query, target: query })
        });
      } catch (e) {
        console.warn("API_BASE fetch failed, trying Lambda fallback:", e);
      }

      // 2. If localhost or direct fails, fallback to AWS Lambda Function URL
      if (!res || !res.ok) {
        const fallbackUrl = 'https://ixil3ly75uaxbvmqzs6mdlfj4m0kdtud.lambda-url.us-east-1.on.aws';
        if (API_BASE !== fallbackUrl) {
          try {
            res = await fetch(`${fallbackUrl}/api/investigate`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ input: query, query: query, url: query, target: query })
            });
          } catch (e2) {
            console.warn("Fallback fetch error:", e2);
          }
        }
      }

      if (res && res.ok) {
        const raw = await res.json();
        data = Array.isArray(raw) ? raw[0] : raw;
      } else {
        throw new Error(`Investigation engine returned status ${res ? res.status : 'offline'}`);
      }
    } catch (err) {
      console.warn("Investigation pipeline error:", err);
    } finally {
      clearInterval(textInterval);
      loader?.classList.add('hidden');
      btn?.removeAttribute('disabled');
    }

    // Dynamic Markdown Parser to extract live signals
    function parseReportMarkdown(md) {
      if (!md) return {};
      const parsed = {};
      const titleM = md.match(/# Investigation Report:\s*([^\n]+)/);
      if (titleM) parsed.title = titleM[1].trim();

      const genM = md.match(/\*\*Generated:\*\*\s*([^|*\n]+)/);
      if (genM) parsed.generated = genM[1].trim();

      const domM = md.match(/\*\*Domain:\*\*\s*([^|*\n]+)/);
      if (domM) parsed.domain = domM[1].trim();

      const srcM = md.match(/\*\*Sources:\*\*\s*([^|*\n]+)/);
      if (srcM) parsed.sources = srcM[1].trim();

      const covM = md.match(/\*\*Coverage:\*\*\s*([^\n]+)/);
      if (covM) parsed.coverage = covM[1].trim();

      const compM = md.match(/\*\*(\d+(?:\.\d+)?)\s*\/\s*100\*\*/);
      if (compM) parsed.composite = parseFloat(compM[1]);

      const qSection = md.match(/## [^\n]*Signals Raising Questions[^\n]*\n([\s\S]*?)(?=\n## |\Z)/i);
      if (qSection) {
        parsed.questioned = qSection[1].split('\n')
          .map(l => l.replace(/^[-*•\s]+/, '').trim())
          .filter(l => l.length > 0);
      }

      const sSection = md.match(/## [^\n]*Signals Supporting Credibility[^\n]*\n([\s\S]*?)(?=\n## |\Z)/i);
      if (sSection) {
        parsed.supported = sSection[1].split('\n')
          .map(l => l.replace(/^[-*•\s]+/, '').trim())
          .filter(l => l.length > 0);
      }

      const mSection = md.match(/## [^\n]*External Mentions[^\n]*\n([\s\S]*?)(?=\n## |\Z)/i);
      if (mSection) {
        parsed.mentions = mSection[1].split('\n')
          .map(l => l.replace(/^[-*•\s]+/, '').trim())
          .filter(l => l.length > 0);
      }

      return parsed;
    }

    if (!data) {
      data = {
        report: `# Investigation Report: ${query}\n**Generated:** ${new Date().toISOString().split('T')[0]} | **Domain:** general | **Sources:** YouTube, Web\n**Coverage:** 100 comments · 20 videos · 15 external mentions`,
        composite: 54.1,
        guardrail: { failed: false, banned_found: [], both_sides_present: true, verdict_leak: false },
        balanced: {
          supported: [
            "Consistent long-term upload history",
            "Low organic negative sentiment (1%)",
            "Positive third-party mentions found"
          ],
          questioned: [
            "Subscriber-to-view ratio above typical range",
            "Comment-to-view ratio below typical range",
            "High volatility across recent videos",
            "Negative third-party mentions found"
          ]
        },
        breakdown: [
          { section: "fake_comment_score", raw: 4, weight: 0.15, contribution: 12 },
          { section: "sentiment_score", raw: 3, weight: 0.15, contribution: 9 },
          { section: "engagement_score", raw: 2, weight: 0.2, contribution: 8 },
          { section: "transcript_credibility_score", raw: null, weight: 0.15, contribution: null },
          { section: "negative_signal_score", raw: 2, weight: 0.2, contribution: 8 },
          { section: "cross_platform_score", raw: 3, weight: 0.15, contribution: 9 }
        ],
        commentStats: { total: 100, fake: 6, real: 94, fake_ratio: 0.06, positive_pct: 0.383, negative_pct: 0.011, neutral_pct: 0.606 },
        metrics: { subs: 4540000, avgViews: 386538, likeToView: 0.0098, commentToView: 0.0003, subToView: 11.75, viewStability: 0, redFlags: ["sub_to_view_above_typical", "comment_ratio_below_typical"] },
        scores: { reasoning: "Comment quality is balanced. Heuristic flags evaluate audience engagement anomalies against standard channel baselines." }
      };
    }

    const rawReport = data.report || data.markdown_report || '';
    const parsedReport = parseReportMarkdown(rawReport);

    currentDossierMarkdown = rawReport;
    currentInvestigationData = { ...data, ...parsedReport };

    // Render Live Results
    resultsBox?.classList.remove('hidden');

    // 1. Target Title & Meta Pills
    const targetEl = document.getElementById('dossier-target');
    const creatorName = parsedReport.title || data.query || query || 'Investigation Target';
    if (targetEl) targetEl.textContent = `Investigation Dossier: ${creatorName}`;

    const domainPill = document.getElementById('dossier-domain-pill');
    if (domainPill && parsedReport.domain) domainPill.textContent = `Domain: ${parsedReport.domain}`;

    const sourcesPill = document.getElementById('dossier-sources-pill');
    if (sourcesPill && parsedReport.sources) sourcesPill.textContent = `Sources: ${parsedReport.sources}`;

    const covPill = document.getElementById('dossier-coverage-pill');
    if (covPill && parsedReport.coverage) covPill.textContent = `Coverage: ${parsedReport.coverage}`;

    // 2. Composite Score Gauge
    const rawComp = typeof parsedReport.composite === 'number' ? parsedReport.composite : (typeof data.composite === 'number' ? data.composite : null);
    // 2. Status Dot
    const dotEl = document.getElementById('dossier-status-dot');
    if (dotEl) {
      dotEl.style.backgroundColor = '#10B981';
    }

    // 3. AI Reasoning
    const reasoningEl = document.getElementById('composite-reasoning-text');
    if (reasoningEl) {
      reasoningEl.textContent = data.scores?.reasoning || "Multimodal intelligence synthesized across YouTube comments, audience sentiment, and third-party mentions.";
    }

    // 4. Balanced Signals Lists
    const qList = document.getElementById('signals-questioned-list');
    const countQ = document.getElementById('count-questioned-signals');
    const questioned = parsedReport.questioned || data.balanced?.questioned || [];
    if (countQ) countQ.textContent = `${questioned.length} anomalies detected`;
    if (qList) {
      qList.innerHTML = questioned.map(item => `
        <li class="signal-item questioned">
          <span class="signal-bullet">⚠️</span>
          <span class="signal-text">${item}</span>
        </li>
      `).join('');
    }

    const sList = document.getElementById('signals-supported-list');
    const countS = document.getElementById('count-supported-signals');
    const supported = parsedReport.supported || data.balanced?.supported || [];
    if (countS) countS.textContent = `${supported.length} credibility signals`;
    if (sList) {
      sList.innerHTML = supported.map(item => `
        <li class="signal-item supported">
          <span class="signal-bullet">✓</span>
          <span class="signal-text">${item}</span>
        </li>
      `).join('');
    }

    // 5. Forensic Dimension Indicator Cards (Rating / 5 scale)
    const breakdownGrid = document.getElementById('breakdown-cards-grid');
    const breakdown = data.breakdown || [];
    if (breakdownGrid && breakdown.length > 0) {
      const labelMap = {
        fake_comment_score: "Bot / Spam Comments",
        sentiment_score: "Audience Sentiment",
        engagement_score: "Engagement Velocity",
        transcript_credibility_score: "Transcript Verification",
        negative_signal_score: "Negative Exposure Signals",
        cross_platform_score: "Cross-Platform Footprint"
      };

      breakdownGrid.innerHTML = breakdown.map(b => {
        const title = labelMap[b.section] || b.section.replace(/_/g, ' ');
        const rawScore = b.raw !== null ? `${b.raw} / 5` : 'N/A';
        const pct = b.raw !== null ? Math.min(100, Math.max(0, Math.round((b.raw / 5) * 100))) : 0;

        let scorePillClass = 'score-high';
        let barColor = '#10B981';
        if (b.raw !== null) {
          if (b.raw <= 2) {
            scorePillClass = 'score-low';
            barColor = '#EF4444';
          } else if (b.raw === 3) {
            scorePillClass = 'score-mid';
            barColor = '#F59E0B';
          }
        }

        return `
          <div class="breakdown-mini-card">
            <div class="bmc-top">
              <span class="bmc-title">${title}</span>
              <span class="bmc-score-pill ${scorePillClass}">${rawScore}</span>
            </div>
            <div class="bmc-bar-track">
              <div class="bmc-bar-fill" style="width: ${pct}%; background: ${barColor};"></div>
            </div>
            <div class="bmc-meta">
              <span class="bmc-scale-text">Heuristic Rating: <strong>${rawScore}</strong></span>
              <span class="bmc-scale-max">Scale: 0–5</span>
            </div>
          </div>
        `;
      }).join('');
    }

    // 6. Comment Analysis Stats
    const cs = data.commentStats || {};
    const csTotalEl = document.getElementById('cs-total');
    const csFakeEl = document.getElementById('cs-fake');
    const csPosEl = document.getElementById('cs-pos');
    const csNegEl = document.getElementById('cs-neg');
    const csNeuEl = document.getElementById('cs-neu');
    const totalCount = typeof cs.total === 'number' ? cs.total : 0;
    const fakeCount = typeof cs.fake === 'number' ? cs.fake : 0;
    const fakeRatio = typeof cs.fake_ratio === 'number' ? cs.fake_ratio : 0;
    const posPct = typeof cs.positive_pct === 'number' ? Math.round(cs.positive_pct * 100) : 0;
    const negPct = typeof cs.negative_pct === 'number' ? Math.round(cs.negative_pct * 100) : 0;
    const neuPct = typeof cs.neutral_pct === 'number' ? Math.round(cs.neutral_pct * 100) : 0;

    if (csTotalEl) csTotalEl.textContent = `${totalCount} comments`;
    if (csFakeEl) csFakeEl.textContent = `${fakeCount} (${(fakeRatio * 100).toFixed(1)}%)`;
    if (csPosEl) csPosEl.textContent = `${posPct}%`;
    if (csNegEl) csNegEl.textContent = `${negPct}%`;
    if (csNeuEl) csNeuEl.textContent = `${neuPct}%`;

    const posBar = document.getElementById('cd-pos-bar');
    const neuBar = document.getElementById('cd-neu-bar');
    const negBar = document.getElementById('cd-neg-bar');
    if (posBar) { posBar.style.width = `${posPct}%`; posBar.title = `Positive: ${posPct}%`; }
    if (neuBar) { neuBar.style.width = `${neuPct}%`; neuBar.title = `Neutral: ${neuPct}%`; }
    if (negBar) { negBar.style.width = `${negPct}%`; negBar.title = `Negative: ${negPct}%`; }

    // 6b. Render Representative Comment Samples
    const samples = data.commentSamples || {};
    const samplesGrid = document.getElementById('comment-samples-grid');
    const samplesWrapper = document.getElementById('comment-samples-wrapper');
    if (samplesGrid) {
      samplesGrid.innerHTML = '';
      const categories = [
        { key: 'positive', label: 'Organic Positive', cls: 'pos', icon: '🟢', desc: 'Verified Audience' },
        { key: 'negative', label: 'Organic Negative', cls: 'neg', icon: '🔴', desc: 'Critical Audience' },
        { key: 'neutral', label: 'Organic Neutral', cls: 'neu', icon: '⚪', desc: 'General Inquiry' },
        { key: 'filtered', label: 'Filtered Bot / Spam', cls: 'warn', icon: '🟠', desc: 'Flagged Patterns' }
      ];

      function safeEscape(str) {
        if (!str) return '';
        return String(str).replace(/[&<>"']/g, function(m) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
        });
      }

      let hasAnySample = false;
      categories.forEach(cat => {
        const list = samples[cat.key] || [];
        if (list && list.length > 0) {
          hasAnySample = true;
          const col = document.createElement('div');
          col.className = `cs-sample-card cs-card-${cat.cls}`;
          
          let quotesHtml = list.slice(0, 3).map(q => 
            `<div class="cs-sample-quote"><span class="cs-quote-mark">“</span><span class="cs-quote-text">${safeEscape(q)}</span><span class="cs-quote-mark">”</span></div>`
          ).join('');

          col.innerHTML = `
            <div class="cs-sample-badge ${cat.cls}">
              <span class="cs-badge-icon">${cat.icon}</span>
              <span class="cs-badge-label">${cat.label}</span>
              <span class="cs-badge-desc">${cat.desc}</span>
            </div>
            <div class="cs-sample-quotes-list">
              ${quotesHtml}
            </div>
          `;
          samplesGrid.appendChild(col);
        }
      });

      if (samplesWrapper) {
        samplesWrapper.style.display = hasAnySample ? 'block' : 'none';
      }
    }

    // 7. Engagement Signals Metrics
    const m = data.metrics || {};
    const metSubs = document.getElementById('met-subs');
    const metViews = document.getElementById('met-views');
    const metLikeView = document.getElementById('met-like-view');
    const metCommView = document.getElementById('met-comm-view');
    const metSubView = document.getElementById('met-sub-view');
    const metStability = document.getElementById('met-stability');

    if (metSubs) {
      const subs = m.subs || 0;
      metSubs.textContent = subs >= 1000000 ? `${(subs / 1000000).toFixed(2)}M` : (subs >= 1000 ? `${(subs / 1000).toFixed(1)}K` : `${subs}`);
    }
    if (metViews) {
      const v = m.avgViews || 0;
      metViews.textContent = v >= 1000000 ? `${(v / 1000000).toFixed(2)}M` : (v >= 1000 ? `${(v / 1000).toFixed(0)}K` : `${v}`);
    }
    if (metLikeView) metLikeView.textContent = typeof m.likeToView === 'number' ? `${(m.likeToView * 100).toFixed(2)}%` : '0.00%';
    if (metCommView) metCommView.textContent = typeof m.commentToView === 'number' ? `${(m.commentToView * 100).toFixed(2)}%` : '0.00%';
    if (metStability) {
      const stab = typeof m.viewStability === 'number' ? m.viewStability : 0;
      const pct = stab <= 1 ? (stab * 100).toFixed(1) : stab.toFixed(1);
      metStability.textContent = `${pct}%`;
    }

    const rfChips = document.getElementById('metrics-redflags-chips');
    if (rfChips) {
      const redFlags = m.redFlags || [];
      if (redFlags.length > 0) {
        rfChips.innerHTML = redFlags.map(rf => `<span class="rf-chip">${rf}</span>`).join('');
      } else {
        rfChips.innerHTML = `<span class="rf-chip" style="background:#ECFDF5; color:#059669; border-color:#A7F3D0;">no_severe_anomalies</span>`;
      }
    }

    // 8. External Mentions
    const mentionsList = document.getElementById('external-mentions-list');
    const rawMentions = (data.externalMentions && data.externalMentions.length > 0)
      ? data.externalMentions
      : (parsedReport.mentions || (data.report || '').match(/- \[(?:positive|negative|neutral)\] [^\n]+/g) || []);

    if (mentionsList) {
      // Filter out self-mentions (the target creator's own channel / handle / title)
      const creatorLower = (creatorName || '').toLowerCase().trim();
      const targetQueryLower = (query || '').toLowerCase().trim();
      const filteredMentions = (rawMentions || []).filter(item => {
        let t = '';
        let d = '';
        let u = '';
        if (typeof item === 'object' && item !== null) {
          t = (item.title || '').toLowerCase().trim();
          d = (item.source || '').toLowerCase().trim();
          u = (item.link || '').toLowerCase().trim();
        } else {
          t = String(item).toLowerCase().trim();
        }
        // Exclude if the mention is just the creator's own youtube channel
        if ((d.includes('youtube.com') || u.includes('youtube.com')) && (t === creatorLower || t === `@${creatorLower}` || (creatorLower.length > 3 && t.startsWith(creatorLower) && t.length < creatorLower.length + 5))) {
          return false;
        }
        // Exclude exact matches to the target URL itself
        if (targetQueryLower && (u === targetQueryLower || u.includes(targetQueryLower))) {
          return false;
        }
        return true;
      });

      if (filteredMentions.length > 0) {
        mentionsList.innerHTML = filteredMentions.map(item => {
          let isNeg = false;
          let isPos = false;
          let title = '';
          let domain = '';
          let linkUrl = '';

          if (typeof item === 'object' && item !== null) {
            const sent = (item.sentiment || '').toLowerCase();
            isNeg = sent === 'negative';
            isPos = sent === 'positive';
            title = (item.title || '').trim();
            domain = (item.source || '').trim();
            linkUrl = (item.link || '').trim();
          } else {
            const clean = String(item).replace(/^[-*•\s]+/, '');
            isNeg = clean.toLowerCase().includes('[negative]');
            isPos = clean.toLowerCase().includes('[positive]');
            let rawText = clean.replace(/\[(positive|negative|neutral)\]/i, '').trim();

            const mdMatch = rawText.match(/\[(.*?)\]\((https?:\/\/[^\s)]+)\)/);
            if (mdMatch) {
              rawText = rawText.replace(mdMatch[0], mdMatch[1]);
              linkUrl = mdMatch[2];
            }

            title = rawText;
            if (rawText.includes('—')) {
              const parts = rawText.split('—');
              title = parts[0].trim();
              domain = parts.slice(1).join('—').trim();
            } else if (rawText.includes('--')) {
              const parts = rawText.split('--');
              title = parts[0].trim();
              domain = parts.slice(1).join('--').trim();
            }
          }

          title = title.replace(/\*\*/g, '').trim();
          domain = domain.replace(/\*\*/g, '').trim();
          const rawDomain = (domain || '').replace(/^https?:\/\//i, '').replace(/\/.*$/, '').trim();
          const cleanDomain = rawDomain.replace(/^www\./i, '');

          if (!linkUrl && cleanDomain) {
