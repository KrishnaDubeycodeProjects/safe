          } else if (targetStr.includes('wikipedia.org')) {
            brandLabel = 'Wikipedia';
            brandIconSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="#334155" style="flex-shrink:0;"><path d="M12.09 13.124l2.457 5.676h1.636l4.636-10.704h-1.636l-3.273 7.854-2.182-5.044.818-1.89h-3.818l-.982 2.27-2.182 5.044-3.273-7.854H2.727l4.636 10.704h1.636l2.455-5.676.636-1.47z"/></svg>`;
          } else if (targetStr.includes('gov.uk')) {
