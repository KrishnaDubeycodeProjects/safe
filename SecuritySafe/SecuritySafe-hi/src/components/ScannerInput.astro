            else if (targetStr.includes('news18')) brandLabel = 'news18.com';
            else if (targetStr.includes('ndtv')) brandLabel = 'ndtv.com';
            else if (targetStr.includes('bbc')) brandLabel = 'bbc.com';
            else if (targetStr.includes('reuters')) brandLabel = 'reuters.com';
            else if (targetStr.includes('bloomberg')) brandLabel = 'bloomberg.com';
            else if (targetStr.includes('forbes')) brandLabel = 'forbes.com';
            brandIconSvg = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg>`;
          } else {
            // For any generic long subdomain, keep just the last 2 parts (e.g. foo.bar.com -> bar.com)
            const parts = cleanDomain.split('.');
            if (parts.length > 2) {
              brandLabel = parts.slice(-2).join('.');
            }
            brandIconSvg = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"/></svg>`;
