          return `
            <a href="${linkUrl || '#'}" target="_blank" rel="noopener noreferrer" class="mention-item ${isNeg ? 'item-warn' : (isPos ? 'item-verified' : 'item-media')}" title="Open: ${title}">
              <div class="mention-left">
                <span class="mention-badge ${badgeClass}">
