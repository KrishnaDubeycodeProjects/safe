      if (typeof n !== 'number') return '—';
      if (n >= 1000000) return (n / 1000000).toFixed(2) + 'M';
      if (n >= 1000) return (n / 1000).toFixed(1) + 'K';
      return String(n);
    };

    const subsEl = document.getElementById('met-subs');
    if (subsEl) subsEl.textContent = fmtNum(met.subs);
