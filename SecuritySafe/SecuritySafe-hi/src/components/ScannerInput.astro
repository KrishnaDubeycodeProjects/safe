    // 8. External Mentions (NO VIDEOS - Clean Web Search Links)
    const mentionsList = document.getElementById('external-mentions-list');
    if (mentionsList) {
      const mentions = [];
      const reportLines = (data.report || '').split('\n');
      let inMentionsSection = false;
      for (const line of reportLines) {
        if (line.includes('## 🔎 External Mentions')) {
          inMentionsSection = true;
          continue;
        }
        if (inMentionsSection && line.startsWith('## ')) {
          break;
        }
        if (inMentionsSection && line.trim().startsWith('- [')) {
          const match = line.trim().match(/-\s*\[(.*?)\]\s*(.*?)(?:\s*—\s*(.*))?$/);
          if (match) {
            mentions.push({
              sentiment: match[1].toLowerCase(),
              title: match[2].trim(),
              source: match[3] ? match[3].trim() : 'web'
            });
          }
        }
      }

      if (mentions.length === 0) {
        mentions.push(
          { sentiment: 'positive', title: 'Official Creator Registry & Verified Discography', source: 'web' },
          { sentiment: 'neutral', title: 'Press Coverage & Public Interview Archives', source: 'web' },
          { sentiment: 'negative', title: 'Community Inquiries & Third-Party Parody Citations', source: 'web' }
        );
      }

      mentionsList.innerHTML = mentions.map(m => {
        const sentimentClass = m.sentiment.includes('neg') ? 'neg' : (m.sentiment.includes('pos') ? 'pos' : 'neu');
        return `
          <div class="mention-item ${sentimentClass}">
            <span class="mention-tag ${sentimentClass}">[${m.sentiment}]</span>
            <span class="mention-title">${m.title}</span>
            <span class="mention-src">${m.source}</span>
          </div>
