          const badgeClass = isNeg ? 'mention-neg' : (isPos ? 'mention-pos' : 'mention-neutral');
          const badgeIcon = isNeg ? '⚠️' : (isPos ? '✓' : '📰');
          const badgeText = isNeg ? 'Important Before Buying' : (isPos ? 'Verified Record' : 'Media Coverage');

          // Determine platform-specific brand logo
          const targetStr = (cleanDomain + ' ' + (linkUrl || '')).toLowerCase();
          let brandIconSvg = '';
          let brandLabel = cleanDomain;

          if (targetStr.includes('youtube.com') || targetStr.includes('youtu.be')) {
