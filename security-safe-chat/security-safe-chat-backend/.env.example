# Copy this file to .env and fill values through your deployment secret manager.
# Never commit the resulting .env file.

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_ANTHROPIC_VERSION=bedrock-2023-05-31

# OCR.space
OCR_SPACE_API_KEY=
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_LANGUAGE=eng

# FastAPI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info
CORS_ORIGINS=http://localhost:4321
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Upload protection
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000

# Server-only credentials. Generate long random values in your secret manager.
API_SECRET_KEY=
ADMIN_BLOG_KEY=

# Optional logging and upstream services
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_LOG_CASES=5
BLOG_STORAGE_PATH=blogs_store.json
AI_API_BASE_URL=http://localhost:8001
OPENAI_BASE_URL=
OPENAI_API_KEY=
