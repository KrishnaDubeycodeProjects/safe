# ─────────────────────────────────────────────────────────────────────────────
# Security Safe Chat — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Cheapest Claude model on Bedrock — ideal for fast single-line classification
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Bedrock Claude API version (do not change unless AWS updates it)
BEDROCK_ANTHROPIC_VERSION=bedrock-2023-05-31

# ── OCR.space ─────────────────────────────────────────────────────────────────
OCR_SPACE_API_KEY=K84422890888957
OCR_SPACE_API_URL=https://api.ocr.space/parse/image

# OCR language (default: eng). Supports: ara, chi_sim, fre, ger, hin, etc.
OCR_LANGUAGE=eng

# ── FastAPI App ───────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# Allowed origins for CORS (comma-separated)
# Development: CORS_ORIGINS=*
# Production:  CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*

# Trusted hostnames for Host-header protection (comma-separated, or * for all)
# Production: TRUSTED_HOSTS=yourdomain.com,www.yourdomain.com
TRUSTED_HOSTS=*

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=30        # max requests per window
RATE_LIMIT_WINDOW_SECONDS=60  # rolling window in seconds

# ── Security ──────────────────────────────────────────────────────────────────
# Optional: set a static API key callers must pass as X-API-Key header.
# Leave blank to disable header auth (useful during local dev).
API_SECRET_KEY=

# ── Supabase Logging ──────────────────────────────────────────────────────────
# When the LLM returns a specific case (e.g. case 5 = "err" / safe message),
# the full request + response is logged to the `scam_analysis_logs` table.
#
# SUPABASE_URL         — your project URL (Settings → API → Project URL)
# SUPABASE_SERVICE_KEY — service_role key (Settings → API → Project API keys)
#                        ⚠️  This key bypasses RLS — keep it server-side only!
#
# SUPABASE_LOG_CASES   — comma-separated list of case numbers to log:
#   1 = single scam match    4 = unsure/ambiguous
#   2 = multi-scam match     5 = safe/legitimate (err)  ← default
#   3 = generic scam
#   Use "1,2,3,4,5" to log every classification.
SUPABASE_URL=https://wpouvwyogskbxclqotmd.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_LOG_CASES=5

# ── Blog Management ───────────────────────────────────────────────────────────
# Secret key required in X-Admin-Key header for all admin blog endpoints.
# Use a long random string — this is the ONLY protection on the admin panel.
ADMIN_BLOG_KEY=change-me-use-a-long-random-secret-key-here

# Path where blogs_store.json will be saved
# Development: BLOG_STORAGE_PATH=blogs_store.json
# Production (Docker): BLOG_STORAGE_PATH=/app/data/blogs_store.json
BLOG_STORAGE_PATH=blogs_store.json

# ── AI Backend ────────────────────────────────────────────────────────────────
# Base URL of the Digital-arrest-detector FastAPI (community reporting routes)
AI_API_BASE_URL=http://localhost:8001